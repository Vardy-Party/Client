<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Version.props" />

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>VardyParty.Hosting</RootNamespace>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyVersion>$(ApplicationVersion)</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).0</FileVersion>
		<InformationalVersion>$(ApplicationDisplayVersion)</InformationalVersion>
		<UseMonoRuntime>false</UseMonoRuntime>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.1.26425.128" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VardyParty.Hosting.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VardyParty.Auth\VardyParty.Auth.csproj" />
		<ProjectReference Include="..\VardyParty.Catalog\VardyParty.Catalog.csproj" />
		<ProjectReference Include="..\VardyParty.Kernel\VardyParty.Kernel.csproj" />
		<ProjectReference Include="..\VardyParty.Playback\VardyParty.Playback.csproj" />
		<ProjectReference Include="..\VardyParty.Ports\VardyParty.Ports.csproj" />
		<ProjectReference Include="..\VardyParty.Presentation\VardyParty.Presentation.csproj" />
		<ProjectReference Include="..\VardyParty.Streaming\VardyParty.Streaming.csproj" />
	</ItemGroup>

</Project>
