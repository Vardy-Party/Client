<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Version.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>VardyParty</RootNamespace>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyVersion>$(ApplicationVersion)</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).0</FileVersion>
		<InformationalVersion>$(ApplicationDisplayVersion)</InformationalVersion>
		<UseMonoRuntime>false</UseMonoRuntime>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VardyParty.Core\VardyParty.Core.csproj" />
	</ItemGroup>

</Project>
