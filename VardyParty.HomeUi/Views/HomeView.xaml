<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:hu="clr-namespace:VardyParty.HomeUi"
             xmlns:views="clr-namespace:VardyParty.HomeUi.Views"
             x:Class="VardyParty.HomeUi.Views.HomeView"
             x:DataType="hu:HomeViewModel">

    <ContentView.Resources>
        <!-- Shared league-row template: CollectionView on Android (RecyclerView
             + D-pad router), ScrollView + BindableLayout elsewhere.
             HeightRequest is the CONTENT height (header + strip) — without
             it CollectionView stretches each item to the leftover viewport
             (black slab under the cards). Margin (RowSpacing) sits outside. -->
        <DataTemplate x:Key="LeagueRowTemplate" x:DataType="hu:LeagueRowViewModel">
            <VerticalStackLayout VerticalOptions="Start"
                                 HeightRequest="{Binding Layout.LeagueRowHeight}"
                                 Margin="{Binding Layout.RowMarginThickness}"
                                 Spacing="10">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="{Binding LeagueIcon}"
                           WidthRequest="{Binding Layout.LeagueIconSize}"
                           HeightRequest="{Binding Layout.LeagueIconSize}"
                           Aspect="AspectFit"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasLeagueIcon}" />
                    <Label Text="{Binding League}"
                           FontSize="{Binding Layout.LeagueTitleFontSize}"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Border Padding="8,2"
                            BackgroundColor="#8CBE1233"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            VerticalOptions="Center"
                            IsVisible="{Binding HasLiveGames}">
                        <Label Text="LIVE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#FECACA" />
                    </Border>
                    <Label Text="{Binding MatchCountText}"
                           FontSize="{Binding Layout.PageSubtitleFontSize}"
                           TextColor="#5B6478"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <ScrollView HeightRequest="{Binding Layout.RowHeight}"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalScrollBarVisibility="Never"
                            Scrolled="OnStripScrolled">
                    <HorizontalStackLayout Spacing="{Binding Layout.CardSpacing}"
                                           Padding="{Binding Layout.StripPaddingThickness}"
                                           BindableLayout.ItemsSource="{Binding Cards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="hu:MatchCardViewModel">
                                <views:MatchCardView />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentView.Resources>

    <Grid BackgroundColor="#0B0F1A">
        <Grid RowDefinitions="Auto,Auto,*" Padding="{Binding Layout.PagePaddingThickness}">

            <!-- Header: brand row (3D metallic crest + wordmark) and menu -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
                <views:BrandLogoView x:Name="BrandLogo"
                                     Margin="0,0,14,0"
                                     VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Vardy Party"
                           FontSize="{Binding Layout.PageTitleFontSize}"
                           FontAttributes="Bold"
                           TextColor="White">
                        <Label.Shadow>
                            <Shadow Brush="Black" Opacity="0.55" Radius="6" Offset="0,2" />
                        </Label.Shadow>
                    </Label>
                    <Label Text="{Binding Subtitle}"
                           FontSize="{Binding Layout.PageSubtitleFontSize}"
                           TextColor="#8A93A6" />
                </VerticalStackLayout>
                <Grid Grid.Column="2" VerticalOptions="Center">
                    <Button x:Name="MenuButton"
                            Text="Menu"
                            Clicked="OnMenuClicked"
                            Focused="OnMenuItemFocused"
                            Unfocused="OnHeaderUnfocused"
                            BackgroundColor="#1C2333"
                            TextColor="#E5E7EB"
                            CornerRadius="10"
                            Padding="18,10"
                            VerticalOptions="Center" />
                    <Border HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-6,-6,0"
                            Padding="0"
                            WidthRequest="18"
                            HeightRequest="18"
                            BackgroundColor="#34D399"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            IsVisible="{Binding HasUpdateAvailable}"
                            InputTransparent="True">
                        <Label Text="★"
                               FontSize="10"
                               TextColor="#0B0F1A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Service error banner -->
            <Border Grid.Row="1"
                    Margin="0,0,0,14"
                    Padding="14,10"
                    BackgroundColor="#33BE1233"
                    Stroke="#59FF6B7C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="#FECACA"
                       FontSize="{Binding Layout.PageSubtitleFontSize}" />
            </Border>

            <!-- Android: CollectionView (RecyclerView + TvDpadFocusRouter).
                 Desktop/Windows: ScrollView — WinUI/Avalonia CollectionView
                 stretched items even with VerticalOptions=Start; those heads
                 use BindableLayout. Android keeps CollectionView for D-pad;
                 LeagueRowHeight pins each item so the black slab is zero. -->
            <Grid Grid.Row="2" x:Name="RowsHost" IsVisible="{Binding ShowGameRows}">
                <CollectionView x:Name="RowsList"
                                ItemTemplate="{StaticResource LeagueRowTemplate}"
                                BackgroundColor="#0B0F1A"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Never"
                                SelectionMode="None"
                                IsVisible="False" />
                <ScrollView x:Name="RowsScroll"
                            BackgroundColor="#0B0F1A"
                            VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Never"
                            IsVisible="False">
                    <VerticalStackLayout x:Name="RowsStack"
                                         VerticalOptions="Start"
                                         BindableLayout.ItemTemplate="{StaticResource LeagueRowTemplate}" />
                </ScrollView>
            </Grid>

            <!-- Empty state -->
            <VerticalStackLayout Grid.Row="2"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding ShowEmptyState}">
                <Label Text="No matches right now"
                       FontSize="{Binding Layout.LeagueTitleFontSize}"
                       FontAttributes="Bold"
                       TextColor="#8A93A6"
                       HorizontalTextAlignment="Center" />
                <Label Text="Fixtures appear here as soon as they are published."
                       FontSize="{Binding Layout.PageSubtitleFontSize}"
                       TextColor="#5B6478"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Menu scrim -->
        <BoxView Color="#99000000" IsVisible="{Binding IsMenuOpen}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Menu: league hide/show + settings -->
        <Border x:Name="MenuPanel"
                WidthRequest="340"
                HorizontalOptions="End"
                VerticalOptions="Fill"
                Margin="{OnPlatform WinUI='0,48,0,0', Default=0}"
                BackgroundColor="#111726"
                Stroke="#26FFFFFF"
                StrokeThickness="1"
                IsVisible="{Binding IsMenuOpen}">
            <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                    <Button Text="✕"
                            Clicked="OnCloseMenuClicked"
                            Focused="OnMenuItemFocused"
                            BackgroundColor="Transparent"
                            TextColor="#8A93A6"
                            Padding="8,2"
                            SemanticProperties.Hint="Close menu" />
                    <Label Grid.Column="1"
                           Text="Leagues"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"
                           Margin="12,0,0,0" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeagueToggles}">
                        <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="hu:LeagueToggleViewModel">
                            <HorizontalStackLayout Spacing="10" Padding="0,6">
                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Focused="OnMenuItemFocused"
                                          Color="#34D399"
                                          VerticalOptions="Center" />
                                <Label Text="{Binding Name}"
                                       TextColor="#E5E7EB"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,16,0,0">
                    <Button Text="Show all"
                            Clicked="OnShowAllClicked"
                            Focused="OnMenuItemFocused"
                            BackgroundColor="#1C2333"
                            TextColor="#E5E7EB"
                            CornerRadius="10" />
                    <Button Text="Reset to defaults"
                            Clicked="OnResetClicked"
                            Focused="OnMenuItemFocused"
                            BackgroundColor="Transparent"
                            BorderColor="#2B3448"
                            BorderWidth="1"
                            TextColor="#8A93A6"
                            CornerRadius="10" />
                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout Grid.Row="3" Spacing="10" Margin="0,18,0,0">
                    <BoxView HeightRequest="1" Color="#26FFFFFF" />
                    <Label Text="Settings"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="UI sounds"
                               TextColor="#E5E7EB"
                               FontSize="15"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding UiSoundsEnabled, Mode=TwoWay}"
                                Focused="OnMenuItemFocused"
                                OnColor="#34D399"
                                VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Goal notifications"
                               TextColor="#E5E7EB"
                               FontSize="15"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding GoalNotificationsEnabled, Mode=TwoWay}"
                                Focused="OnMenuItemFocused"
                                OnColor="#34D399"
                                VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="DNS over HTTPS fallback"
                               TextColor="#E5E7EB"
                               FontSize="15"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding DnsOverHttpsFallbackEnabled, Mode=TwoWay}"
                                Focused="OnMenuItemFocused"
                                OnColor="#34D399"
                                VerticalOptions="Center" />
                    </Grid>
                    <Button Text="{Binding UpdateButtonLabel}"
                            Clicked="OnUpdateClicked"
                            Focused="OnMenuItemFocused"
                            IsVisible="{Binding ShowUpdateButton}"
                            IsEnabled="{Binding UpdateIdle}"
                            BackgroundColor="#1C4A3A"
                            TextColor="#34D399"
                            CornerRadius="10" />
                    <Button Text="Sign out"
                            Clicked="OnSignOutClicked"
                            Focused="OnMenuItemFocused"
                            IsVisible="{Binding CanSignOut}"
                            BackgroundColor="Transparent"
                            BorderColor="#59FF6B7C"
                            BorderWidth="1"
                            TextColor="#FECACA"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Match-event toast overlay: topmost, input-transparent, never
             focusable. Placement/animations live in its code-behind. -->
        <views:MatchEventToastView BindingContext="{Binding Toast}" />
    </Grid>
</ContentView>
