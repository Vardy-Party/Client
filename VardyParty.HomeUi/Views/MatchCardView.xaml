<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:hu="clr-namespace:VardyParty.HomeUi"
             x:Class="VardyParty.HomeUi.Views.MatchCardView"
             x:DataType="hu:MatchCardViewModel">

    <ContentView.Resources>
        <!-- Brushed-metal ring around each badge -->
        <LinearGradientBrush x:Key="MetallicRingBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDFDFD" Offset="0" />
            <GradientStop Color="#C2C8D0" Offset="0.30" />
            <GradientStop Color="#848B96" Offset="0.50" />
            <GradientStop Color="#D9DDE2" Offset="0.72" />
            <GradientStop Color="#F4F6F8" Offset="1" />
        </LinearGradientBrush>

        <!-- Glass highlight over the top half of the badge -->
        <LinearGradientBrush x:Key="BadgeGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.40" />
            <GradientStop Color="#00FFFFFF" Offset="0.55" />
        </LinearGradientBrush>

        <!-- Light band swept across the card on hover/focus -->
        <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#30FFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
    </ContentView.Resources>

    <Border x:Name="CardOuter"
            WidthRequest="{Binding Layout.CardWidth}"
            HeightRequest="{Binding Layout.CardHeight}"
            Margin="{Binding Layout.CardMarginThickness}"
            BackgroundColor="#141926"
            Stroke="#26FFFFFF"
            StrokeThickness="1">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.35" Radius="18" Offset="0,6" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Border.GestureRecognizers>

        <Grid>
            <!-- Ephemeral team-colour wash -->
            <BoxView Background="{Binding CardBackground}" InputTransparent="True" />

            <!-- Team accent edges -->
            <BoxView WidthRequest="5" HorizontalOptions="Start" Background="{Binding HomeAccent}"
                     Opacity="0.95" InputTransparent="True" />
            <BoxView WidthRequest="5" HorizontalOptions="End" Background="{Binding AwayAccent}"
                     Opacity="0.95" InputTransparent="True" />

            <!-- Sheen sweep (animated from code-behind on hover/focus) -->
            <BoxView x:Name="Sheen"
                     WidthRequest="130"
                     HorizontalOptions="Start"
                     VerticalOptions="Fill"
                     Background="{StaticResource SheenBrush}"
                     Opacity="0"
                     InputTransparent="True" />

            <!-- Selected/resolving veil: gold wash pulsed from code-behind while
                 the picked card's stream resolution is in flight -->
            <BoxView x:Name="SelectedVeil"
                     Color="#FFD54F"
                     Opacity="0"
                     InputTransparent="True" />

            <Grid RowDefinitions="Auto,*" Padding="14,10,14,12">
                <!-- Status + aggregate chips -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Padding="10,4"
                            VerticalOptions="Center"
                            BackgroundColor="#4A000000"
                            Stroke="#24FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 999">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#8CBE1233" />
                                <Setter Property="Stroke" Value="#59FF6B7C" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse x:Name="LiveDot"
                                     WidthRequest="7" HeightRequest="7"
                                     Fill="#FF4D5E"
                                     VerticalOptions="Center"
                                     IsVisible="{Binding IsLive}" />
                            <Label Text="{Binding StatusText}"
                                   FontSize="{Binding Layout.StatusFontSize}"
                                   FontAttributes="Bold"
                                   TextColor="#F3F4F6"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            Padding="9,4"
                            VerticalOptions="Center"
                            BackgroundColor="#40000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            IsVisible="{Binding HasAggregate}">
                        <Label Text="{Binding AggregateText}"
                               FontSize="{Binding Layout.AggregateFontSize}"
                               TextColor="#D1D5DB" />
                    </Border>
                </Grid>

                <!-- Teams and score -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid WidthRequest="{Binding Layout.BadgeSize}"
                              HeightRequest="{Binding Layout.BadgeSize}"
                              HorizontalOptions="Center">
                            <!-- Treated badge: metallic ring, inner plate, gloss -->
                            <Border StrokeShape="Ellipse"
                                    StrokeThickness="0"
                                    Background="{StaticResource MetallicRingBrush}"
                                    Padding="3"
                                    IsVisible="{Binding HasHomeBadge}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.45" Radius="9" Offset="0,3" />
                                </Border.Shadow>
                                <Grid>
                                    <Border StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="#F3F5F8" Padding="5">
                                        <Image Source="{Binding HomeBadge}" Aspect="AspectFit" />
                                    </Border>
                                    <Border StrokeShape="Ellipse" StrokeThickness="0"
                                            Background="{StaticResource BadgeGlossBrush}"
                                            InputTransparent="True" />
                                </Grid>
                            </Border>
                            <!-- Monogram fallback in team colour -->
                            <Border StrokeShape="Ellipse"
                                    Stroke="#40FFFFFF"
                                    StrokeThickness="1"
                                    Background="{Binding HomeAccent}"
                                    IsVisible="{Binding NoHomeBadge}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.45" Radius="9" Offset="0,3" />
                                </Border.Shadow>
                                <Label Text="{Binding HomeInitial}"
                                       FontSize="{Binding Layout.TeamFontSize}"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding HomeTeam}"
                               FontSize="{Binding Layout.TeamFontSize}"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Label Grid.Column="1"
                           Text="{Binding ScoreText}"
                           Margin="12,0"
                           FontSize="{Binding Layout.ScoreFontSize}"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ScoreIsDim}" Value="True">
                                <Setter Property="TextColor" Value="#8A93A6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <VerticalStackLayout Grid.Column="2" Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid WidthRequest="{Binding Layout.BadgeSize}"
                              HeightRequest="{Binding Layout.BadgeSize}"
                              HorizontalOptions="Center">
                            <Border StrokeShape="Ellipse"
                                    StrokeThickness="0"
                                    Background="{StaticResource MetallicRingBrush}"
                                    Padding="3"
                                    IsVisible="{Binding HasAwayBadge}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.45" Radius="9" Offset="0,3" />
                                </Border.Shadow>
                                <Grid>
                                    <Border StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="#F3F5F8" Padding="5">
                                        <Image Source="{Binding AwayBadge}" Aspect="AspectFit" />
                                    </Border>
                                    <Border StrokeShape="Ellipse" StrokeThickness="0"
                                            Background="{StaticResource BadgeGlossBrush}"
                                            InputTransparent="True" />
                                </Grid>
                            </Border>
                            <Border StrokeShape="Ellipse"
                                    Stroke="#40FFFFFF"
                                    StrokeThickness="1"
                                    Background="{Binding AwayAccent}"
                                    IsVisible="{Binding NoAwayBadge}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.45" Radius="9" Offset="0,3" />
                                </Border.Shadow>
                                <Label Text="{Binding AwayInitial}"
                                       FontSize="{Binding Layout.TeamFontSize}"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding AwayTeam}"
                               FontSize="{Binding Layout.TeamFontSize}"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Focus ring: pre-built chrome, faded in/out on focus with an
                 opacity animation only (native View alpha). Mutating the MAUI
                 Shadow per focus move forced a blur re-render that visibly
                 janked the 32-bit TV box; this ring never re-measures. -->
            <Border x:Name="FocusRing"
                    Stroke="#AFCBFF"
                    StrokeThickness="3"
                    Opacity="0"
                    InputTransparent="True" />
        </Grid>
    </Border>
</ContentView>
