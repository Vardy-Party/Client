<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Version.props" />

	<PropertyGroup>
		<!--
			Shared .NET MAUI XAML homepage. net11.0 builds today (drawn by Avalonia via
			Avalonia.Controls.Maui in VardyParty.Desktop). Adding net11.0-android later
			lets the existing MAUI Android head consume the exact same XAML natively.

			Singular TargetFramework on purpose: Directory.Build.targets strips the
			TargetFramework global property off every ProjectReference, which breaks the
			cross-targeting (plural TargetFrameworks) reference protocol - the referencing
			project would get no compiled output back. When this project multi-targets,
			referencing heads must override GlobalPropertiesToRemove on their
			ProjectReference to keep TargetFramework negotiation intact.
		-->
		<TargetFramework>net11.0</TargetFramework>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>VardyParty.HomeUi</RootNamespace>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyVersion>$(ApplicationVersion)</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).0</FileVersion>
		<InformationalVersion>$(ApplicationDisplayVersion)</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
		<!-- Renders the BBC SVG badges to bitmaps that MAUI Image can display everywhere. -->
		<PackageReference Include="Svg.Skia" Version="5.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VardyParty.Kernel\VardyParty.Kernel.csproj" />
		<ProjectReference Include="..\VardyParty.Catalog\VardyParty.Catalog.csproj" />
		<ProjectReference Include="..\VardyParty.Presentation\VardyParty.Presentation.csproj" />
	</ItemGroup>

</Project>
