<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VardyParty.Linux"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="VardyParty.Linux.MainWindow"
    x:DataType="local:MainWindowViewModel"
        Title="Vardy Party"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" IsVisible="{Binding ShowMainPanel}">
            <TextBlock Grid.Row="0"
                       Text="Vardy Party"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White" />

            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       Margin="0,12,0,12"
                       Foreground="White" />

            <Border Grid.Row="3"
                    BorderThickness="1"
                    BorderBrush="#374151"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    IsVisible="{Binding ShowAuthPanel}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="220" Height="220" Background="White" CornerRadius="6" Padding="4">
                        <Image Source="{Binding DeviceQrCode}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="16,0,0,0">
                        <TextBlock Text="Device Login" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Scan QR code or open this URL:" Foreground="#D1D5DB" />
                        <SelectableTextBlock Text="{Binding DeviceVerificationUri}" Foreground="#93C5FD" />
                        <TextBlock Text="Enter code:" Foreground="#D1D5DB" Margin="0,8,0,0" />
                        <SelectableTextBlock Text="{Binding DeviceUserCode}" FontSize="20" FontWeight="Bold" Foreground="#FCD34D" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" BorderThickness="1" BorderBrush="#374151" CornerRadius="8" Padding="8" IsVisible="{Binding ShowGamesPanel}">
                <ListBox x:Name="GamesList"
                         ItemsSource="{Binding Games}"
                         SelectedItem="{Binding SelectedGame}"
                         SelectionChanged="OnGamesSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:GameListItem">
                            <Grid ColumnDefinitions="2*,2*,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Fixture}" Foreground="White" />
                                <TextBlock Grid.Column="1" Text="{Binding League}" Foreground="#D1D5DB" />
                                <TextBlock Grid.Column="2" Text="{Binding Kickoff}" Foreground="#9CA3AF" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#FCD34D" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding ShowVideoPanel}" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#111827" Padding="8">
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="88"
                        Height="36"
                        Click="OnCloseVideoClicked" />
            </Border>
            <Grid Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
