<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VardyParty.Linux"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="VardyParty.Linux.MainWindow"
    x:DataType="local:MainWindowViewModel"
        Title="Vardy Party"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" IsVisible="{Binding ShowMainPanel}">
            <TextBlock Grid.Row="0"
                       Text="Vardy Party"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White" />

            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       Margin="0,12,0,12"
                       Foreground="White" />

            <Border Grid.Row="3"
                    BorderThickness="1"
                    BorderBrush="#374151"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    IsVisible="{Binding ShowAuthPanel}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="220" Height="220" Background="White" CornerRadius="6" Padding="4">
                        <Image Source="{Binding DeviceQrCode}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="16,0,0,0">
                        <TextBlock Text="Device Login" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Scan QR code or open this URL:" Foreground="#D1D5DB" />
                        <SelectableTextBlock Text="{Binding DeviceVerificationUri}" Foreground="#93C5FD" />
                        <TextBlock Text="Enter code:" Foreground="#D1D5DB" Margin="0,8,0,0" />
                        <SelectableTextBlock Text="{Binding DeviceUserCode}" FontSize="20" FontWeight="Bold" Foreground="#FCD34D" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderThickness="1" BorderBrush="#374151" CornerRadius="8" Padding="8" IsVisible="{Binding ShowGamesPanel}">
                <ListBox x:Name="GamesList"
                         ItemsSource="{Binding Games}"
                         SelectedItem="{Binding SelectedGame}"
                         SelectionChanged="OnGamesSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:GameListItem">
                            <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,*" Margin="0,6" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StatusText}"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <Border Grid.Column="1"
                                        Background="White"
                                        CornerRadius="4"
                                        Padding="2"
                                        Margin="0,0,12,0"
                                        IsVisible="{Binding HasLeagueIcon}"
                                        VerticalAlignment="Center">
                                    <Image Width="24"
                                           Height="24"
                                           Source="{Binding LeagueIcon}"
                                           Stretch="Uniform" />
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding HomeTeam}"
                                           Foreground="White"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="3"
                                        Background="White"
                                        CornerRadius="14"
                                        Padding="2"
                                        Margin="0,0,6,0"
                                        IsVisible="{Binding HasHomeBadge}"
                                        VerticalAlignment="Center">
                                    <Image Width="28"
                                           Height="28"
                                           Source="{Binding HomeBadge}"
                                           Stretch="Uniform" />
                                </Border>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding ScoreText}"
                                           Foreground="#FCD34D"
                                           Margin="12,0"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="5"
                                        Background="White"
                                        CornerRadius="14"
                                        Padding="2"
                                        Margin="6,0,0,0"
                                        IsVisible="{Binding HasAwayBadge}"
                                        VerticalAlignment="Center">
                                    <Image Width="28"
                                           Height="28"
                                           Source="{Binding AwayBadge}"
                                           Stretch="Uniform" />
                                </Border>

                                <TextBlock Grid.Column="6"
                                           Text="{Binding AwayTeam}"
                                           Foreground="White"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding ShowVideoPanel}" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#111827" Padding="8">
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="88"
                        Height="36"
                        Click="OnCloseVideoClicked" />
            </Border>
            <Border Grid.Row="1" Background="#000000">
                <vlc:VideoView x:Name="VideoSurface"
                               MediaPlayer="{Binding VideoMediaPlayer}" />
            </Border>
        </Grid>
    </Grid>
</Window>
