<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\vardyparty.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>VardyParty.Linux</RootNamespace>
    <AssemblyName>VardyParty</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI Framework -->
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.2" />
    
    <!-- Avalonia Diagnostics (Debug only) -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.2.2" />
    
    <!-- LibVLC for video playback -->
    <PackageReference Include="LibVLCSharp" Version="3.9.0" />
    <!-- Note: VideoLAN.LibVLC.Linux will be installed as system dependency, not NuGet package -->
    
    <!-- Configuration and Logging -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to shared Core library -->
    <ProjectReference Include="..\VardyParty.Core\VardyParty.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy Blazor components from main MAUI project -->
    <Compile Include="..\VardyParty\Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\VardyParty\Components\**\*.cs" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    
    <!-- Copy shared assets -->
    <Content Include="..\VardyParty\wwwroot\**\*.*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
