# Copy to .env (gitignored) in the repo root only when .env is absent.
# Never overwrite an existing .env.
# Sync signing secrets: pwsh scripts/sync-github-secrets-from-env.ps1
#
# WINDOWS_CERT_BASE64=
# WINDOWS_CERT_PASSWORD=
#
# Linux snap minisign (hashed ED). Base64 of keyId[8] + seed[32].
# MINISIGN_SECRET_KEY=
#
# Vardy-Party GitHub Packages for package-android.ps1 (read:packages).
# Named for this repo so another GitHub account on the machine is not used.
# VARDYPARTY_CLIENT_PACKAGES_TOKEN=
# VARDYPARTY_CLIENT_PACKAGES_USER=Vardy-Party
