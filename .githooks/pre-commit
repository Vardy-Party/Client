#!/usr/bin/env bash
# Feature-branch stand-in for a hook on main (GitHub.com has none).
# Include the next ApplicationVersion in this commit so it merges with the PR.
set -euo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "${branch}" == "main" ]]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
script="${root}/scripts/sync-application-version.sh"
if [[ ! -f "${script}" ]]; then
  exit 0
fi

cd "${root}"
chmod +x "${script}"
before=$(sed -n 's/.*<ApplicationVersion>\([0-9][0-9]*\)<\/ApplicationVersion>.*/\1/p' Version.props | head -n 1)
"${script}" --write >/dev/null
after=$(sed -n 's/.*<ApplicationVersion>\([0-9][0-9]*\)<\/ApplicationVersion>.*/\1/p' Version.props | head -n 1)
if [[ "${before}" == "${after}" ]]; then
  exit 0
fi
git add Version.props
echo "ApplicationVersion ${before} → ${after} (feature-branch bump; lands with this PR)" >&2
