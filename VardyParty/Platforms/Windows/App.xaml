<maui:MauiWinUIApplication
    x:Class="VardyParty.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:VardyParty.WinUI">

    <Application.Resources>
        <!-- Replace MAUI's default app title row (shows Window.Title) with nothing. -->
        <DataTemplate x:Key="MauiAppTitleBarContainerTemplate">
            <Grid HorizontalAlignment="Stretch" Height="0" />
        </DataTemplate>
    </Application.Resources>

</maui:MauiWinUIApplication>
