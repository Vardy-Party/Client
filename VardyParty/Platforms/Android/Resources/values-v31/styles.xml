<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!-- Do not override windowSplashScreenAnimatedIcon: API 31 forces a 108dp
         circle (empty center of our 512 splash = solid blue). TV still uses
         the full window drawable; phones get a full-screen overlay in MainActivity. -->
    <style name="VardyParty.SplashTheme" parent="Maui.SplashTheme">
        <item name="android:windowBackground">@drawable/splash_full</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
    </style>
</resources>
