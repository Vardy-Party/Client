@page "/"
@inject IEnrichedGameService GameService
@inject NavigationManager Navigation
@inject SelectionState Selection
@inject ILogger<Home> Logger
@inject IStreamResolutionOrchestrator StreamResolutionOrchestrator
@inject IServiceProvider ServiceProvider
@inject IAuthLoginService AuthLoginService
@inject IAuthTokenProvider AuthTokenProvider
@inject ILocalLanServiceAvailabilityMonitor LocalLanServiceAvailabilityMonitor
@inject ILeagueFilterService LeagueFilter
@using Microsoft.Extensions.Logging
@using QRCoder
@using VardyParty.Models
@using VardyParty.Orchestrators
@using VardyParty.Providers
@using VardyParty.Services
@implements IDisposable

<div class="page-shell@(GetPlatformShellClass())">
    <header class="page-header">
        <div class="page-header-inner">
            <div class="header-left">
                <AppMenu @ref="appMenu" IsAuthenticated="isAuthenticated" OnSignOut="SignOutAsync" />
            </div>
            <div class="header-brand">
                <img src="images/vardyparty_splash.svg" class="app-logo" alt="VardyParty Logo" />
                <div class="header-title" role="heading" aria-level="1">Vardy Party</div>
            </div>
        </div>
    </header>

    <div class="page-body">
    @if (!string.IsNullOrWhiteSpace(localServiceWarning))
    {
        <div class="local-service-warning">@localServiceWarning</div>
    }
    @if (!string.IsNullOrWhiteSpace(statusMessage) && isAuthenticated && games.Count > 0)
    {
        <div class="local-service-warning">@statusMessage</div>
    }

    @if (authReady && !isAuthenticated)
    {
        <div class="auth-hero@(deviceCode != null ? " auth-hero-device" : string.Empty)">
            @if (deviceCode != null)
            {
                <div class="auth-device">
                    <div class="auth-device-copy">
                        <p class="auth-device-code">Code <strong>@deviceCode.UserCode</strong></p>
                        <button @ref="authCancelButtonRef"
                                type="button"
                                class="auth-cancel"
                                tabindex="0"
                                autofocus="true"
                                @onclick="CancelSignIn"
                                @onkeydown="OnAuthCancelKeyDown">Cancel</button>
                        @if (!string.IsNullOrWhiteSpace(authStatusMessage))
                        {
                            <div class="auth-message">@authStatusMessage</div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(deviceQrDataUri))
                    {
                        <img src="@deviceQrDataUri" alt="Device login QR code" class="qr-image"/>
                    }
                    <p class="auth-device-uri">Scan the QR code, or open <strong>@deviceQrTarget</strong></p>
                </div>
            }
            else
            {
                <div class="auth-hero-inner">
                    <div class="state-icon state-icon-auth" aria-hidden="true">🔐</div>
                    <p class="welcome-text">Welcome — please sign in to browse today's matches.</p>
                    <div class="auth-actions">
                        <button @ref="signInContinueButtonRef"
                                type="button"
                                class="btn btn-primary auth-action"
                                tabindex="0"
                                autofocus="@(!isAuthenticating)"
                                @onclick="StartSignInAsync"
                                @onkeydown="OnSignInContinueKeyDown"
                                disabled="@isAuthenticating">@(!isAuthenticating ? "Sign in — Continue" : "Signing in…")</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(authStatusMessage))
                    {
                        <div class="auth-message">@authStatusMessage</div>
                    }
                </div>
            }
        </div>
    }

    @if (!authReady || (isLoading && isAuthenticated))
    {
        <div class="loading-container">
            <div class="state-icon state-icon-loading" aria-hidden="true"></div>
            <p class="loading-text">@(authReady ? "Loading matches" : "Starting")</p>
            @if (authReady && !string.IsNullOrEmpty(statusMessage))
            {
                <p class="status-message">@statusMessage</p>
            }
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="empty-state empty-state-muted">
            <!-- consolidated; hero handles welcome -->
        </div>
    }
    else if (games.Count == 0)
    {
        <div class="empty-state">
            <div class="state-icon state-icon-empty" aria-hidden="true">⚽</div>
            <h2 class="empty-state-title">No matches right now</h2>
            <p class="empty-state-text">Check back later — today's schedule will appear here when games are available.</p>
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <p class="status-message">@statusMessage</p>
            }
        </div>
    }
    else
    {
        <div class="schedule-section">
            <div class="schedule-header">
                <h2 class="schedule-title">Today's matches</h2>
                <span class="schedule-count">@games.Count @(games.Count == 1 ? "game" : "games")</span>
            </div>
            <div class="games-grid">
            @{
                var anySelected = games.Any(IsSelected);
            }
            @for (var i = 0; i < games.Count; i++)
            {
                var game = games[i];
                var isSelected = IsSelected(game);
                // TV: autofocus first card for D-pad entry only — never ties to .selected.
                // .selected comes from explicit OK/click (selectedGame), not games[0] auto-init.
                var shouldFocus = focusPending && (
                    MauiProgram.IsTv
                        ? (!anySelected && i == 0)
                        : (isSelected || (!anySelected && i == 0)));
                var leagueLogo = LeagueLogoMapper.GetLogoForLeague(game);

                <GameCard @key="GameKey(game)"
                          Game="game"
                          IsSelected="isSelected"
                          ShouldFocus="shouldFocus"
                          LeagueLogoUrl="@leagueLogo"
                          OnClick="StartStreamResolution"
                          OnEscapeGrid="EscapeGridToMenu"/>
            }
            </div>
        </div>
    }

    </div>
</div>

<!-- Stream Resolution Progress Indicator -->
@if (isResolvingStreams)
{
    <div class="stream-progress-overlay">
        @if (OperatingSystem.IsWindows())
        {
            <button class="overlay-close" @onclick="OnOverlayCloseRequested">✕</button>
        }
        @{
            var isNoHealthy = !string.IsNullOrEmpty(streamResolutionStatus) &&
                              streamResolutionStatus.Contains("No healthy streams", StringComparison.OrdinalIgnoreCase);
        }
        <div class="stream-progress-card">
            <div class="progress-details">
                @{
                    var titleText = isNoHealthy
                        ? string.Empty
                        : streamResolutionStatus == "Playing..."
                            ? "Now Playing"
                            : "Finding streams...";
                }
                @if (!string.IsNullOrEmpty(titleText))
                {
                    <p class="progress-title">@titleText</p>
                }
                @if (!string.IsNullOrEmpty(streamResolutionStatus) && !string.Equals(streamResolutionStatus, "Searching for streams", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="progress-stats @(isNoHealthy ? "progress-title-warning" : string.Empty)">
                        @if (isNoHealthy)
                        {
                            <span class="progress-warning-icon">⚠</span>
                        }
                        @streamResolutionStatus
                    </p>
                }
                @if (!isNoHealthy)
                {
                    <div class="progress-bar-container">
                        @if (totalStreamsFound > 0)
                        {
                            var progressPercentage = streamsTested * 100 / totalStreamsFound;
                            <div class="progress-bar-determinate" style="width: @(progressPercentage)%"></div>
                        }
                        else
                        {
                            <div class="progress-bar-indeterminate"></div>
                        }
                    </div>
                }
                <p class="progress-count">
                    @if (totalStreamsFound > 0)
                    {
                        @totalStreamsFound
                        <text> total • </text>
                        @streamsTested
                        <text> tested • </text>
                        @healthyStreamCount
                        <text> healthy</text>
                    }
                    else
                    {
                        @streamsTested
                        <text> tested • </text>
                        @healthyStreamCount
                        <text> healthy</text>
                    }
                </p>
            </div>
        </div>
    </div>
}

@code {
    private AppMenu? appMenu;
    private readonly List<Game> games = new();
    private bool isLoading = true;
    private bool focusPending = true;
    private bool signInContinueFocusPending;
    private bool authCancelFocusPending;
    private bool authReady;
    private ElementReference signInContinueButtonRef;
    private ElementReference authCancelButtonRef;

    private static string GetPlatformShellClass()
    {
        if (OperatingSystem.IsWindows()) return " platform-windows";
        if (OperatingSystem.IsAndroid())
        {
            return MauiProgram.IsTv ? " platform-android platform-android-tv" : " platform-android";
        }

        return string.Empty;
    }
    private IDisposable? _gamesSubscription;
    private IDisposable? _errorSubscription;
    private IDisposable? _localLanWarningSubscription;
    private CancellationTokenSource? _streamResolutionCts;
    private IOverlayCloseService? _overlayCloseService;
    private CancellationTokenSource? _authCts;
    private bool isAuthenticating;
    private bool isAuthenticated;
    private string authStatusMessage = string.Empty;
    private AuthDeviceCode? deviceCode;
    private string? deviceQrDataUri;
    private string? deviceQrTarget;
    private string? localServiceWarning;
    private string statusMessage = string.Empty;

    // Stream resolution state
    private bool isResolvingStreams;
    private string streamResolutionStatus = string.Empty;
    private int totalStreamsFound;
    private int streamsTested;
    private int healthyStreamCount;
    private Game? selectedGame;
    private IDisposable? _progressSubscription;

    private Task? _streamResolutionTask;

    // Indicates we have finished testing all streams for the currently selected game
    private bool _resolutionExhausted;

    private async Task EscapeGridToMenu()
    {
        if (appMenu != null)
            await appMenu.FocusMenuButtonAsync();
    }

    private void PublishHomeUiUpdate()
    {
#if WINDOWS
        if (MainPage.IsNativePlayerActive) return;
#endif
#if ANDROID
        // Don't re-render the game cards while the flyout menu is open — the DOM churn
        // underneath the backdrop races against AppMenu's focus-restore and blurs the
        // focused league button. The menu will re-render itself when it closes.
        if (MainActivity.IsFlyoutMenuOpen) return;
#endif
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetOverlayBackSuppression(bool suppress)
    {
#if ANDROID
        try
        {
            MainActivity.SetOverlayBackSuppression(suppress);
        }
        catch
        {
        }
#endif
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("[Home] OnInitialized start");
        isLoading = true;
        isAuthenticated = await AuthTokenProvider.IsAuthenticatedAsync();
        authReady = true;

        if (isAuthenticated)
        {
            await LoadGamesAsync();
        }
        else
        {
            isLoading = false;
            signInContinueFocusPending = true;
        }

        Logger.LogInformation("[Home] OnInitialized complete (authenticated={Authenticated})", isAuthenticated);
        ApplyPlaybackErrorFromQuery();
        if (OperatingSystem.IsWindows())
        {
            try
            {
                _overlayCloseService = ServiceProvider?.GetService(typeof(IOverlayCloseService)) as IOverlayCloseService;
                if (_overlayCloseService != null)
                {
                    _overlayCloseService.CloseRequested -= OnOverlayCloseRequested;
                    _overlayCloseService.CloseRequested += OnOverlayCloseRequested;
                }
            }
            catch
            {
            }
        }
        // Subscribe to Android remote Back while on Home so Back cancels stream resolution when visible
#if ANDROID
        try
        {
            var remote = MainActivity.RemoteKeyHandler;
            remote.OnBack -= AndroidBackHandler;
            remote.OnBack += AndroidBackHandler;
        }
        catch
        {
        }
#endif

        _localLanWarningSubscription = LocalLanServiceAvailabilityMonitor.WarningStream.Subscribe(OnLocalLanWarningUpdated);
    }


#if ANDROID
    private void AndroidBackHandler(global::Android.Views.Keycode kc)
    {
        if (MainActivity.IsFlyoutMenuOpen)
        {
            return;
        }

        // Device QR screen: Back cancels sign-in (same as Cancel).
        if (!isAuthenticated && deviceCode != null)
        {
            Logger.LogInformation("[Home] Android back pressed during device sign-in — canceling");
            CancelSignIn();
            return;
        }

        Logger.LogInformation("[Home] Android back pressed - canceling stream resolution if active");
        try
        {
            _streamResolutionCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            StreamResolutionOrchestrator.Reset();
        }
        catch
        {
        }

        // Ensure we fully stop resolution and clear selection so OnAfterRender does not restart it
        Selection.CurrentGame = null;
        selectedGame = null;
        // Give feedback to user via logging (avoid referencing Android UI types in shared component)
        Logger.LogInformation("[Home] Stream discovery cancelled by Back");
        InvokeAsync(() =>
        {
            isResolvingStreams = false;
            streamResolutionStatus = string.Empty;
            totalStreamsFound = 0;
            streamsTested = 0;
            healthyStreamCount = 0;
            StateHasChanged();
        });
        try
        {
            MainActivity.SetOverlayBackSuppression(false);
        }
        catch
        {
        }
    }
#if ANDROID
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        // Allow overlay to consume Back when visible
        try
        {
            MainActivity.SetOverlayBackSuppression(isResolvingStreams);
        }
        catch
        {
        }
    }
#endif
#endif

    private async Task StartSignInAsync()
    {
        if (isAuthenticating) return;

        Logger.LogInformation("[Home] Sign in — Continue pressed (IsTv={IsTv})", MauiProgram.IsTv);
        isAuthenticating = true;
        authStatusMessage = string.Empty;
        deviceCode = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (MauiProgram.IsTv || !MauiProgram.IsWindowsPackaged)
            {
                var deviceLogin = await AuthLoginService.StartDeviceLoginAsync();
                if (deviceLogin == null)
                {
                    authStatusMessage = "Unable to start device sign-in.";
                    return;
                }

                deviceCode = deviceLogin.DeviceCode;
                authCancelFocusPending = true;

                // Generate local QR for device flow
                deviceQrTarget = string.IsNullOrWhiteSpace(deviceCode.VerificationUriComplete) ? deviceCode.VerificationUri : deviceCode.VerificationUriComplete;
                try
                {
                    using var qrGenerator = new QRCodeGenerator();
                    var qrData = qrGenerator.CreateQrCode(deviceQrTarget ?? string.Empty, QRCodeGenerator.ECCLevel.Q);
                    var pngQr = new PngByteQRCode(qrData);
                    var pngBytes = pngQr.GetGraphic(20);
                    deviceQrDataUri = "data:image/png;base64," + Convert.ToBase64String(pngBytes);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[Home] Failed to generate QR code locally");
                    deviceQrDataUri = null;
                }

                await InvokeAsync(StateHasChanged);

                _authCts?.Cancel();
                _authCts = new CancellationTokenSource();

                var result = await AuthLoginService.PollDeviceLoginAsync(deviceLogin.DeviceCode, _authCts.Token);
        if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.AccessToken))
                {
                    isAuthenticated = true;
                    authStatusMessage = string.Empty;
                    deviceCode = null;
                    focusPending = true;
                    await LoadGamesAsync();
                }
                else if (!string.IsNullOrWhiteSpace(result.Error))
                {
                    authStatusMessage = result.Error;
                }
            }
            else
            {
                var result = await AuthLoginService.LoginInteractiveAsync();
                if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.AccessToken))
                {
                    isAuthenticated = true;
                    authStatusMessage = string.Empty;
                    focusPending = true;
                    await LoadGamesAsync();
                }
                else if (!string.IsNullOrWhiteSpace(result.Error))
                {
                    authStatusMessage = result.Error;
                }
            }
        }
        catch (OperationCanceledException)
        {
            authStatusMessage = "Sign-in canceled.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[Home] Sign-in failed");
            authStatusMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Sign-in failed."
                : ex.Message;
        }
        finally
        {
            isAuthenticating = false;
            if (!isAuthenticated)
            {
                signInContinueFocusPending = true;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSignInContinueKeyDown(KeyboardEventArgs e)
    {
        // Android TV remotes often send Enter/DPAD_CENTER without a click event.
        if (e.Key is "Enter" or " " or "Spacebar" or "NumpadEnter")
        {
            await StartSignInAsync();
        }
    }

    private void OnAuthCancelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar" or "NumpadEnter")
        {
            CancelSignIn();
        }
    }

    private async Task SignOutAsync()
    {
        try
        {
            _authCts?.Cancel();
        }
        catch
        {
        }

        _authCts = null;
        isAuthenticating = false;
        deviceCode = null;
        deviceQrDataUri = null;
        deviceQrTarget = null;

        await AuthTokenProvider.LogoutAsync();

        _gamesSubscription?.Dispose();
        _gamesSubscription = null;
        _errorSubscription?.Dispose();
        _errorSubscription = null;
        _localLanWarningSubscription?.Dispose();
        _localLanWarningSubscription = null;
        _progressSubscription?.Dispose();
        _progressSubscription = null;
        StreamResolutionOrchestrator.Reset();

        games.Clear();
        Selection.CurrentGame = null;
        selectedGame = null;
        statusMessage = string.Empty;
        authStatusMessage = string.Empty;
        isAuthenticated = false;
        isLoading = false;
        focusPending = true;
        signInContinueFocusPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelSignIn()
    {
        _authCts?.Cancel();
        deviceCode = null;
        deviceQrDataUri = null;
        deviceQrTarget = null;
        isAuthenticating = false;
        authStatusMessage = "Sign-in canceled.";
        signInContinueFocusPending = true;
    }

    private void OnOverlayCloseRequested()
    {
        Logger.LogInformation("[Home] Overlay close requested");
        try
        {
            _streamResolutionCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            StreamResolutionOrchestrator.Reset();
        }
        catch
        {
        }

        try
        {
            _progressSubscription?.Dispose();
        }
        catch
        {
        }

        _progressSubscription = null;
        _resolutionExhausted = true;
        Selection.CurrentGame = null;
        selectedGame = null;
        isResolvingStreams = false;
        streamResolutionStatus = string.Empty;
        totalStreamsFound = 0;
        streamsTested = 0;
        healthyStreamCount = 0;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending && isAuthenticated && games.Count > 0)
        {
            focusPending = false;
        }

        // Android TV / D-pad: put focus on Sign in — Continue when that CTA is visible.
        // Without this, the header menu button typically owns first focus.
        if (signInContinueFocusPending
            && !isAuthenticated
            && !isAuthenticating
            && deviceCode == null)
        {
            try
            {
                await signInContinueButtonRef.FocusAsync();
                signInContinueFocusPending = false;
            }
            catch
            {
                // Element may not be ready yet; retry on next render.
            }
        }

        if (authCancelFocusPending && !isAuthenticated && deviceCode != null)
        {
            try
            {
                await authCancelButtonRef.FocusAsync();
                authCancelFocusPending = false;
            }
            catch
            {
            }
        }

        // If user returned from native player (selectedGame still set) restart stream resolution
        // so UI resumes discovering streams automatically.
        try
        {
            if (!isResolvingStreams && selectedGame != null)
            {
                // Do not restart if we've already exhausted resolution for this selection
                if (_resolutionExhausted)
                {
                    selectedGame = null;
                    Selection.CurrentGame = null;
                }
                else
                {
                    // Only restart resolution if the user did not explicitly cancel (Selection.CurrentGame indicates intent)
                    if (Selection.CurrentGame != null && Selection.CurrentGame == selectedGame)
                    {
                        // Restart resolution in background
                        _ = StartStreamResolution(selectedGame);
                    }
                    else
                    {
                        // Clear selection if we should not restart
                        selectedGame = null;
                        Selection.CurrentGame = null;
                    }
                }
            }
        }
        catch
        {
        }
    }

    private void OnGamesUpdated(Dictionary<string, List<Game>>? updatedGames)
    {
        if (updatedGames == null)
        {
            Logger.LogInformation("[Home] Games updated: null (initial state)");
            return;
        }

        Logger.LogInformation("[Home] Games updated: {Count} leagues", updatedGames.Count);

        // This method is used when subscribing directly to the raw GamesStream
        games.Clear();

        foreach (var kvp in updatedGames)
        {
            var leagueGames = kvp.Value ?? new List<Game>();
            games.AddRange(LeagueFilter.FilterGames(leagueGames));
        }

        EnsureInitialSelection();
        isLoading = false;
        statusMessage = string.Empty;
        // TV: re-arm focus so the first card regains D-pad focus after a background games refresh.
        if (MauiProgram.IsTv && !isResolvingStreams && selectedGame == null)
            focusPending = true;
        PublishHomeUiUpdate();
    }

    // Handler for flattened display list
    private void OnGamesUpdatedFlattened(List<Game>? updatedGames)
    {
        if (updatedGames == null)
        {
            Logger.LogInformation("[Home] Games updated (flattened): null (initial state)");
            return;
        }

        Logger.LogInformation("[Home] Games updated (flattened): {Count} games", updatedGames.Count);

        games.Clear();
        games.AddRange(LeagueFilter.FilterGames(updatedGames));

        EnsureInitialSelection();
        isLoading = false;
        statusMessage = string.Empty;
        // TV: re-arm focus so the first card regains D-pad focus after a background games refresh.
        if (MauiProgram.IsTv && !isResolvingStreams && selectedGame == null)
            focusPending = true;
        PublishHomeUiUpdate();
    }

    private void EnsureInitialSelection()
    {
        if (games.Count == 0)
        {
            Selection.CurrentGame = null;
            selectedGame = null;
            return;
        }

        // TV: D-pad focus is the navigation cue. Never auto-select games[0] — that left a
        // sticky .selected ring that did not move when the user chose another match.
        // Rebind an explicit OK/click selection onto refreshed Game instances only.
        if (MauiProgram.IsTv)
        {
            if (selectedGame != null)
            {
                var match = FindMatchingGame(selectedGame);
                selectedGame = match;
                Selection.CurrentGame = match;
            }
            else
            {
                // Drop any leftover CurrentGame so IsSelected cannot stick on games[0].
                Selection.CurrentGame = null;
            }

            return;
        }

        if (selectedGame == null || Selection.CurrentGame == null)
        {
            Selection.CurrentGame = games[0];
            selectedGame = games[0];
            return;
        }

        var existing = FindMatchingGame(selectedGame);
        if (existing == null)
        {
            Selection.CurrentGame = games[0];
            selectedGame = games[0];
        }
        else
        {
            Selection.CurrentGame = existing;
            selectedGame = existing;
        }
    }

    private void OnErrorUpdated(string? error)
    {
        if (error == null)
        {
            Logger.LogInformation("[Home] Error cleared");
            statusMessage = string.Empty;
            PublishHomeUiUpdate();
            return;
        }

        Logger.LogWarning("[Home] Error: {Error}", error);
        statusMessage = error;
        PublishHomeUiUpdate();
    }

    /// <summary>
    /// UI .selected must track the game the user chose (OK/click via selectedGame),
    /// not Selection.CurrentGame alone — that was auto-initialized to games[0] and stayed sticky.
    /// </summary>
    private bool IsSelected(Game game)
    {
        if (selectedGame == null) return false;
        return SameGame(game, selectedGame);
    }

    private Game? FindMatchingGame(Game target) =>
        games.FirstOrDefault(g => SameGame(g, target));

    private static bool SameGame(Game a, Game b) =>
        string.Equals(a.Home, b.Home, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(a.Away, b.Away, StringComparison.OrdinalIgnoreCase);

    private static string GameKey(Game game) =>
        $"{game.Home}|{game.Away}|{game.Start:O}";

    private async Task StartStreamResolution(Game game)
    {
        Logger.LogInformation("[Home] Starting stream resolution for {Home} vs {Away}", game.DisplayHome, game.DisplayAway);

        if (_streamResolutionTask is { IsCompleted: false })
        {
            if (selectedGame != null && SameGame(selectedGame, game))
            {
                Logger.LogInformation("[Home] Stream resolution already running for {Home} vs {Away}", game.DisplayHome, game.DisplayAway);
                return;
            }

            _streamResolutionCts?.Cancel();
        }

        // Explicit user choice — drives .selected (IsSelected). Do this before overlay render.
        selectedGame = game;
        Selection.CurrentGame = game;
        isResolvingStreams = true;
        totalStreamsFound = 0;
        streamsTested = 0;
        streamResolutionStatus = "Searching for streams...";
        SetOverlayBackSuppression(true);
        _resolutionExhausted = false;

        _progressSubscription ??= StreamResolutionOrchestrator.ProgressUpdated.Subscribe(progress =>
        {
#if WINDOWS
            if (progress.HealthyStreams > 0)
            {
                isResolvingStreams = false;
                streamResolutionStatus = progress.Status;
                totalStreamsFound = progress.TotalStreams;
                streamsTested = progress.StreamsTested;
                healthyStreamCount = progress.HealthyStreams;
                // Native player replaces the MAUI window — never re-render Blazor after this.
                return;
            }

            isResolvingStreams = progress.IsResolving;
#else
            isResolvingStreams = progress.IsResolving;
#endif
            streamResolutionStatus = progress.Status;
            totalStreamsFound = progress.TotalStreams;
            streamsTested = progress.StreamsTested;
            healthyStreamCount = progress.HealthyStreams;
            PublishHomeUiUpdate();
        });

        await InvokeAsync(StateHasChanged);

#if WINDOWS
        try
        {
            Logger.LogInformation("[Home] Overlay close control should be shown on Windows");
        }
        catch { }
#endif

        _streamResolutionCts?.Cancel();
        _streamResolutionCts = new CancellationTokenSource();
        _streamResolutionTask = Task.Run(async () =>
        {
            try
            {
                var outcome = await StreamResolutionOrchestrator.StartAsync(game, _streamResolutionCts.Token);
                _resolutionExhausted = true;

                if (outcome.UserClosed)
                {
                    Selection.CurrentGame = null;
                    selectedGame = null;
                    return;
                }

                if (outcome.NoWorkingStreams)
                {
                    await InvokeAsync(() => ShowStreamPlaybackError("No working streams found"));
                }
                else if (outcome.PlaybackResult != null && !outcome.PlaybackResult.Success && !outcome.UserClosed)
                {
#if WINDOWS
                    if (!MainPage.IsNativePlayerActive)
#endif
                    {
                        await InvokeAsync(() => ShowStreamPlaybackError(outcome.PlaybackResult.Message));
                    }
                }
            }
            catch (OperationCanceledException)
            {
                Logger.LogInformation("[Home] Stream resolution cancelled");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[Home] Error during stream resolution");
                await InvokeAsync(() =>
                {
                    streamResolutionStatus = $"Error: {ex.Message}";
                    StateHasChanged();
                });
            }
            finally
            {
                await InvokeAsync(() =>
                {
                    isResolvingStreams = false;
                    SetOverlayBackSuppression(false);
                    StateHasChanged();
                });
            }
        });
    }

    private void ShowStreamPlaybackError(string? message)
    {
        statusMessage = message ?? "Stream unavailable";
        streamResolutionStatus = statusMessage;
        isResolvingStreams = false;
        SetOverlayBackSuppression(false);
        StateHasChanged();
    }

    private void ApplyPlaybackErrorFromQuery()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (string.IsNullOrEmpty(query))
        {
            return;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (!string.Equals(Uri.UnescapeDataString(part[..eq]), "error", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var error = Uri.UnescapeDataString(part[(eq + 1)..]);
            if (!string.IsNullOrWhiteSpace(error))
            {
                ShowStreamPlaybackError(error);
            }

            return;
        }
    }

    private void NavigateToStreamsWithError(string? message)
    {
        ShowStreamPlaybackError(message);
    }

    private async Task LoadGamesAsync()
    {
        isLoading = true;

        var enrichedGameService = (IEnrichedGameService?)ServiceProvider?.GetService(typeof(IEnrichedGameService));
        if (enrichedGameService is EnrichedGameService svc)
        {
            svc.StartBackgroundPolling();
        }

        var presentation = (IHomePagePresentationService?)ServiceProvider?.GetService(typeof(IHomePagePresentationService));
        if (presentation != null)
        {
            _gamesSubscription = presentation.DisplayStream.Subscribe(OnGamesUpdatedFlattened);
        }
        else
        {
            _gamesSubscription = GameService.GamesStream.Subscribe(OnGamesUpdated);
        }

        _errorSubscription = GameService.ErrorStream.Subscribe(OnErrorUpdated);
    }

    private void OnLocalLanWarningUpdated(string? warning)
    {
        localServiceWarning = warning;
        PublishHomeUiUpdate();
    }

    public void Dispose()
    {
        Logger.LogInformation("[Home] Disposing");

        _gamesSubscription?.Dispose();
        _errorSubscription?.Dispose();
        _localLanWarningSubscription?.Dispose();
        _progressSubscription?.Dispose();
        StreamResolutionOrchestrator.Reset();
        if (_overlayCloseService != null)
        {
            try
            {
                _overlayCloseService.CloseRequested -= OnOverlayCloseRequested;
            }
            catch
            {
            }

            _overlayCloseService = null;
        }
#if ANDROID
        try
        {
            var remote = MainActivity.RemoteKeyHandler;
            if (remote != null) remote.OnBack -= AndroidBackHandler;
        }
        catch
        {
        }
#endif

        _streamResolutionCts?.Cancel();
        _authCts?.Cancel();
    }

}