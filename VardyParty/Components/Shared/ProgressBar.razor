@namespace VardyParty.Components.Shared
@using Microsoft.AspNetCore.Components

<div class="progress-container" aria-hidden="false">
    <div class="progress-track">
        <div class="progress-fill" style="width:@(Math.Clamp(Value * 100, 0, 100))%"></div>
    </div>
    @if (ShowLabel)
    {
        <div class="progress-label">@LabelText</div>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = false;
    [Parameter] public string LabelText { get; set; } = string.Empty;
}

<style>
.progress-container { width: 100%; padding: 6px 0; }
.progress-track { background: rgba(255,255,255,0.06); height: 8px; border-radius: 4px; overflow: hidden; }
.progress-fill { background: linear-gradient(90deg, #0066ff, #00d4ff); height: 100%; width: 0%; transition: width 150ms linear; }
.progress-label { margin-top: 6px; font-size: 12px; color: #cfcfcf; }
</style>