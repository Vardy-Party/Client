@using VardyParty.Services
@using VardyParty.Models
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IApiService ApiService
@inject INativeVideoPlayerService NativeVideoPlayer
@inject ILogger<VideoPlayerOverlay> Logger

@if (IsVisible)
{
    <div class="video-overlay-backdrop" @onclick="Close">
        <div class="video-overlay-container" @onclick:stopPropagation>
            <div class="video-overlay-header">
                <div class="game-info">
                    <span class="teams">@League | @HomeTeam vs @AwayTeam</span>
                </div>
                <button class="close-button" @onclick="Close">?</button>
            </div>

            <div class="video-player-area">
                <div class="loading-message" style="@(IsLoading ? "display: block;" : "display: none;")">
                    <p>@StatusMessage</p>
                </div>
            </div>

            @if (HealthyStreams.Count > 1)
            {
                <div class="streams-panel">
                    <div class="streams-header">
                        <span>Available Streams (@HealthyStreams.Count)</span>
                    </div>
                    <div class="streams-list">
                        @foreach (var stream in HealthyStreams)
                        {
                            var isSelected = stream == CurrentStream;
                            <div class="stream-item @(isSelected ? "selected" : "")" 
                                 @onclick="() => SwitchStream(stream)">
                                <span class="stream-name">@stream.Stream.Channel</span>
                                @if (!string.IsNullOrEmpty(stream.Stream.Reputation))
                                {
                                    <span class="reputation">@stream.Stream.Reputation</span>
                                }
                                <span class="quality">@stream.GetQualityDisplay()</span>
                                @if (isSelected)
                                {
                                    <span class="selected-indicator">? Playing</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .video-overlay-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .video-overlay-container {
        position: relative;
        width: 90%;
        height: 90%;
        max-width: 1200px;
        background-color: #1a1a1a;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .video-overlay-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background-color: #0d0d0d;
        border-bottom: 1px solid #333;
        color: white;
    }

    .game-info {
        flex: 1;
        font-size: 16px;
    }

    .teams {
        font-weight: bold;
    }

    .close-button {
        background: none;
        border: none;
        color: white;
        font-size: 28px;
        cursor: pointer;
        padding: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .close-button:hover {
        background-color: rgba(255, 0, 0, 0.3);
    }

    .video-player-area {
        flex: 1;
        background-color: #000;
        position: relative;
        overflow: hidden;
    }

    .loading-message {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #aaa;
        text-align: center;
        font-size: 18px;
    }

    .streams-panel {
        width: 250px;
        background-color: #0d0d0d;
        border-left: 1px solid #333;
        display: flex;
        flex-direction: column;
        color: white;
    }

    .streams-header {
        padding: 12px;
        border-bottom: 1px solid #333;
        font-weight: bold;
        font-size: 14px;
    }

    .streams-list {
        flex: 1;
        overflow-y: auto;
    }

    .stream-item {
        padding: 12px;
        border-bottom: 1px solid #222;
        cursor: pointer;
        transition: background-color 0.2s;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stream-item:hover {
        background-color: #1a1a1a;
    }

    .stream-item.selected {
        background-color: #1a3a1a;
        border-left: 3px solid #4CAF50;
    }

    .stream-name {
        font-weight: bold;
        font-size: 13px;
    }

    .reputation {
        font-size: 11px;
        color: #888;
    }

    .quality {
        font-size: 12px;
        color: #aaa;
    }

    .selected-indicator {
        font-size: 11px;
        color: #4CAF50;
        font-weight: bold;
    }
</style>

@code {
    [Parameter]
    public string? League { get; set; }

    [Parameter]
    public string? HomeTeam { get; set; }

    [Parameter]
    public string? AwayTeam { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public List<EnrichedStream> HealthyStreams { get; set; } = new();

    [Parameter]
    public EnrichedStream? CurrentStream { get; set; }

    [Parameter]
    public EventCallback<EnrichedStream> OnStreamSelected { get; set; }

    public bool IsLoading { get; set; } = true;
    public string StatusMessage { get; set; } = "Finding healthy streams...";

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            IsLoading = true;
            StatusMessage = "Finding healthy streams...";
        }
        else if (CurrentStream != null && CurrentStream.Status == StreamResolutionStatus.Healthy)
        {
            IsLoading = false;
        }
    }

    public void UpdateStatus(string message, bool loading = true)
    {
        IsLoading = loading;
        StatusMessage = message;
        StateHasChanged();
    }

    public void StreamResolved()
    {
        IsLoading = false;
        StatusMessage = string.Empty;
        StateHasChanged();
    }

    private async Task SwitchStream(EnrichedStream stream)
    {
        if (stream == CurrentStream)
            return;

        Logger.LogInformation("[VideoOverlay] Switching to stream: {Channel}", stream.Stream.Channel);
        await OnStreamSelected.InvokeAsync(stream);
    }

    private async Task Close()
    {
        Logger.LogInformation("[VideoOverlay] Closing video overlay");
        await OnClose.InvokeAsync();
    }

    void IDisposable.Dispose()
    {
        // Cleanup if needed
    }
}
