{
  "AllowUserSecrets": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "VardyParty": "Information"
    }
  },
  "GamesApi": {
    "CallTimeoutSeconds": 45,
    "MaxRetries": 2,
    "RefreshSchedule": 600,
    "M3U8CallTimeoutSeconds": 30
  },
  "BbcFixtures": {
    "CallTimeoutSeconds": 20,
    "MaxRetries": 1,
    "RefreshSchedule": 60
  },
  "StreamHealth": {
    "ManifestTimeoutSeconds": 20,
    "SegmentTimeoutSeconds": 10,
    "MaxParallelStreams": 2
  }
}
