<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Version.props" />

    <PropertyGroup>
        <!-- Visual Studio IDE on Windows: only Windows TFM (fast IDE experience) -->
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' AND '$(BuildingInsideVisualStudio)' == 'true'">net11.0-windows10.0.19041.0</TargetFrameworks>
        <!-- Windows CLI, local dev (not CI): all TFMs for local APK + MSIX builds -->
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' AND '$(BuildingInsideVisualStudio)' != 'true' AND '$(CI)' != 'true'">net11.0-android;net11.0-ios;net11.0-maccatalyst;net11.0-windows10.0.19041.0</TargetFrameworks>
        <!-- Windows CI: only Windows TFM (CI installs only maui-windows workload) -->
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' AND '$(CI)' == 'true'">net11.0-windows10.0.19041.0</TargetFrameworks>
        <!-- macOS: iOS and macCatalyst -->
        <TargetFrameworks Condition="'$(OS)' != 'Windows_NT' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <!-- Linux (CI or local): Android only -->
        <TargetFrameworks Condition="'$(OS)' != 'Windows_NT' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">net11.0-android</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
        <!-- CoreCLR publish enables ReadyToRun; dual-RID Mac Catalyst Release then
             fails with NETSDK1191 (RID cannot be inferred). Android still needs R2R. -->
        <PublishReadyToRun Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</PublishReadyToRun>

        <OutputType>Exe</OutputType>
        <RootNamespace>VardyParty</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AssemblyVersion>$(ApplicationVersion)</AssemblyVersion>
        <FileVersion>$(ApplicationDisplayVersion).0</FileVersion>
        <InformationalVersion>$(ApplicationDisplayVersion)</InformationalVersion>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<UseMonoRuntime>false</UseMonoRuntime>

		<!-- Display name -->
        <ApplicationTitle>Vardy Party</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.vardyparty</ApplicationId>

        <!-- Versions -->
        <!-- <ApplicationDisplayVersion> and <ApplicationVersion> are now imported from Version.props -->

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <!-- Removed global WindowsPackageType None so per-target Windows packaging settings can apply -->

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <!-- The net11 Mac Catalyst SDK (26.5) enforces a 17.0 minimum; 15.0 fails the build outright. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        
        <!-- Android TV Support -->
        <AndroidEnableProfiledAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableProfiledAot>

        <!-- Android: all ABIs for store / package-android.ps1 -Mode all.
             Device APK (AndroidArmOnly=true): armeabi-v7a TV + arm64-v8a phones.
             Do not pass a semicolon RID list as -p:RuntimeIdentifiers — the SDK
             treats it as one RuntimeIdentifier and fails with NETSDK1083.
             .NET 11 Android runs on CoreCLR only and has no android-x86 runtime
             pack (NETSDK1181), so x86 was dropped from the fat APK; x86_64
             emulators are covered by android-x64. -->
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidArmOnly)' != 'true'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidArmOnly)' == 'true'">android-arm;android-arm64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="'$(AndroidArmOnly)' == 'true'"></RuntimeIdentifier>

        <!-- Trimming stays on for Android (also required: CoreCLR R2R assemblies
             are mixed-mode and the un-trimmed linker path can't rewrite them).
             Mono profiled AOT is gone in .NET 11 (XA1044: RunAOTCompilation is
             incompatible with CoreCLR), so it is guarded to Mono-only targets. -->
        <PublishTrimmed Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</PublishTrimmed>
        <RunAotCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(UseMonoRuntime)' == 'true'">true</RunAotCompilation>

        <!-- FORCE DISABLE Fast Deployment for Android.
             This is critical to prevent the NoClassDefFoundError loop and 6-minute startup delay.
             It ensures assemblies are embedded in the APK, making them visible to the WebView's classloader. -->
        <AndroidFastDeployment>false</AndroidFastDeployment>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

        <!-- A workaround for resource loading performance. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <!-- .NET 11 is CoreCLR-only on android, ios and maccatalyst (NETSDK1242):
         UseMonoRuntime stays off everywhere. -->

    <!-- GenerateBuildInfo: always on Debug; Release via RunGenerateBuildInfo=true (CI publish). -->
    <Target Name="GenerateBuildInfo" BeforeTargets="ProcessMauiAssets" Condition="'$(RunGenerateBuildInfo)' == 'true' Or '$(Configuration)' == 'Debug'">
      <!-- Capture UTC now at target run time (not project-eval time) so package stamps are accurate. -->
      <PropertyGroup>
        <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC</BuildTimestamp>
      </PropertyGroup>
      <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true">
        <Output TaskParameter="ConsoleOutput" PropertyName="GitHashOutput" />
      </Exec>
      <PropertyGroup>
        <GitHash>$(GitHashOutput)</GitHash>
        <GitHash Condition=" '$(GitHash)' == '' ">unknown</GitHash>
      </PropertyGroup>
      <ItemGroup>
        <!-- Semicolon would split into two MSBuild items; write one key per line instead. -->
        <_BuildInfoLine Include="Commit=$(GitHash)" />
        <_BuildInfoLine Include="Built=$(BuildTimestamp)" />
      </ItemGroup>
      <!-- Generated into obj (ignored), not Resources\Raw: the build rewrites this
           file every run, and a tracked copy kept dirtying the working tree. The
           MauiAsset below still ships it in packages under the same logical name. -->
      <PropertyGroup>
        <_BuildInfoFile>$(IntermediateOutputPath)buildinfo.txt</_BuildInfoFile>
      </PropertyGroup>
      <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" />
      <ItemGroup>
        <MauiAsset Include="$(_BuildInfoFile)" LogicalName="buildinfo.txt" />
      </ItemGroup>
      <Message Importance="high" Text="GenerateBuildInfo: $(BuildTimestamp) commit=$(GitHash)" />
    </Target>

    <!-- GenerateSplashWithBuildInfo disabled by default; enable by setting RunGenerateSplash=true.
         Text is rasterized at publish time. Windows has Arial; GitHub Android
         runs on Ubuntu and used to fall back to DejaVu (worse TV splash). Use
         Liberation Sans there (Arial-metric) after CD installs fonts-liberation. -->
    <Target Name="GenerateSplashWithBuildInfo" BeforeTargets="ProcessMauiAssets" DependsOnTargets="GenerateBuildInfo" Condition="'$(RunGenerateSplash)' == 'true'">
      <PropertyGroup>
        <SplashFile>$(MSBuildProjectDirectory)\Resources\Splash\vardyparty_splash_generated.svg</SplashFile>
        <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC</BuildTimestamp>
        <GitHash Condition="'$(GitHash)' == ''">unknown</GitHash>
        <SplashTextFont>Arial</SplashTextFont>
        <SplashTextFont Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Liberation Sans</SplashTextFont>
      </PropertyGroup>
      <MakeDir Directories="$(MSBuildProjectDirectory)\Resources\Splash" />
      <ItemGroup>
        <_SplashLines Include="&lt;svg xmlns='http://www.w3.org/2000/svg' width='512' height='512' viewBox='0 0 512 512'&gt;" />
        <!-- No full-bleed rect: MauiSplashScreen Color paints the screen. A
             matching rect made Android 12+ phones a solid blue circle (the
             system splash masks the image). Logo + build lines stay in the SVG. -->

		<!-- Soccer Ball Logo (centered at 256, 160) -->
		<_SplashLines Include="&lt;g transform='translate(256, 160)'&gt;" />
		<_SplashLines Include="&lt;circle cx='0' cy='0' r='100' fill='#0052B4' stroke='#003090' stroke-width='5'/&gt;" />
		<_SplashLines Include="&lt;path d='M 0,-85 L 28,-35 L 0,-8 L -28,-35 Z' fill='#003090'/&gt;" />
		<_SplashLines Include="&lt;path d='M 28,-35 L 70,-45 L 78,0 L 35,18 L 0,-8 Z' fill='#E8E8E8'/&gt;" />
		<_SplashLines Include="&lt;path d='M -28,-35 L -70,-45 L -78,0 L -35,18 L 0,-8 Z' fill='#E8E8E8'/&gt;" />
		<_SplashLines Include="&lt;path d='M 35,18 L 52,62 L 18,85 L -18,85 L -35,18 Z' fill='#E8E8E8'/&gt;" />
		<_SplashLines Include="&lt;path d='M 0,-8 L 35,18 L -35,18 Z' fill='#D5D5D5'/&gt;" />
		<_SplashLines Include="&lt;/g&gt;" />

		<_SplashLines Include="&lt;text x='256' y='330' font-size='44' fill='#ffffff' font-family='$(SplashTextFont)' font-weight='700' text-anchor='middle'&gt;VardyParty&lt;/text&gt;" />
		<_SplashLines Include="&lt;text x='256' y='380' font-size='24' fill='#ffffff' font-family='$(SplashTextFont)' font-weight='600' text-anchor='middle'&gt;Version $(ApplicationDisplayVersion)&lt;/text&gt;" />
		<_SplashLines Include="&lt;text x='256' y='415' font-size='20' fill='#e0e0e0' font-family='$(SplashTextFont)' text-anchor='middle'&gt;Commit: $(GitHash)&lt;/text&gt;" />
		<_SplashLines Include="&lt;text x='256' y='445' font-size='18' fill='#f0f0f0' font-family='$(SplashTextFont)' text-anchor='middle'&gt;Built: $(BuildTimestamp)&lt;/text&gt;" />
		<_SplashLines Include="&lt;/svg&gt;" />
	  </ItemGroup>
      <WriteLinesToFile File="$(SplashFile)" Lines="@(_SplashLines)" Overwrite="true" />
    </Target>

    <!-- Auto-sync Package.appxmanifest version from .csproj properties for Windows builds -->
    <Target Name="UpdateWindowsPackageVersion" BeforeTargets="_ConvertAppxManifestToGenerationFormat" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
      <PropertyGroup>
        <ManifestFile>$(MSBuildProjectDirectory)\Platforms\Windows\Package.appxmanifest</ManifestFile>
        <!-- MSIX requires 4-part version: Major.Minor.Build.Revision -->
        <MsixVersion>$(ApplicationDisplayVersion).0</MsixVersion>
      </PropertyGroup>
      <Message Text="[VardyParty] Syncing Package.appxmanifest version to $(MsixVersion) from ApplicationDisplayVersion" Importance="high" />
      <!-- Use XML manipulation to properly update version attribute -->
      <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$manifestPath = '$(ManifestFile)'; if (Test-Path $manifestPath) { [xml]$xml = Get-Content $manifestPath; $ns = New-Object System.Xml.XmlNamespaceManager($xml.NameTable); $ns.AddNamespace('pkg', 'http://schemas.microsoft.com/appx/manifest/foundation/windows10'); $identity = $xml.SelectSingleNode('//pkg:Identity', $ns); if ($identity) { $identity.SetAttribute('Version', '$(MsixVersion)'); $xml.Save($manifestPath); Write-Host '[VardyParty] Updated Package.appxmanifest to version $(MsixVersion)' } }&quot;" />
    </Target>


    <!-- Splash uses generated SVG with build info (TV full window + phone overlay). -->
    <ItemGroup>
      <MauiSplashScreen Include="Resources\Splash\vardyparty_splash_generated.svg" Color="#003090" BaseSize="456,456" />
      <!-- Ball-only, for Android 12+ 108dp circular system splash. -->
      <MauiImage Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
                 Include="Resources\Splash\vardyparty_splash.svg"
                 BaseSize="288,288" />
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon: Windows keeps splash-derived tiles; Android/iOS use adaptive square icon -->
        <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" Include="Resources\Splash\vardyparty_splash.svg" Color="#003090" />
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#003090" ForegroundScale="0.92" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        
        <!-- Android TV Banner (wide asset — not the phone launcher icon) -->
        <MauiImage Include="Resources\AppIcon\banner.svg" BaseSize="320,180" />


        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Packaged Windows never unpacked MauiAssets onto disk; MediaPlayer
             and OpenAppPackageFileAsync both miss Sounds/*.wav unless they
             also copy next to the exe / into the loose AppX layout.
             Windows-only: on Android these WAVs ship solely as MauiAssets
             (SoundPool loads assets/Sounds/*.wav via Assets.OpenFd) and an
             unconditioned @(Content) item earns one XA0101 'build action
             not supported' warning per file. -->
        <Content Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
                 Include="Resources\Raw\Sounds\*.wav"
                 Link="Sounds\%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />

        <!-- League logos for the XAML homepage (MauiHomeAssetLocator reads them
             via OpenAppPackageFileAsync). -->
        <MauiAsset Include="Resources\Images\Leagues\**\*.*" LogicalName="images/leagues/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Removed custom deletion of MAUI app compat layout to retain default fragment containers -->

    <!-- Retain default MAUI AppCompat layout -->

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.3" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Auth0.OidcClient.MAUI" Version="1.4.0" />
        <PackageReference Include="QRCoder" Version="1.7.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-android'">
      <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.9.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.9.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Media3.Common" Version="1.9.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.9.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
      <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.15.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Window" Version="1.5.1.3" />
      <!-- Explicit AndroidX Lifecycle packages to resolve version conflicts -->
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
      <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.5.0.1" />
      <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Pages\" />
      <Folder Include="Properties\PublishProfiles\" />
      <Folder Include="ViewModels\" />
    </ItemGroup>

    <!-- RESX resources are included by SDK implicitly; keep Resources.resx under Resources/Strings for generation in IDE/build. -->
    <ItemGroup>
      <!-- Attach ResXFileCodeGenerator to the implicit EmbeddedResource item so IDE generates a designer file -->
      <EmbeddedResource Update="Resources\Strings\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

  <!-- Create placeholder .jlo files for Android ABIs to avoid packaging errors when tooling doesn't generate them -->
  <PropertyGroup>
    <JloFileName>VardyParty.jlo.xml</JloFileName>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefaultLanguage>en</DefaultLanguage>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>288C22050831E54B0553CC6932F67FC809879A22</PackageCertificateThumbprint>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts Condition="'$(Configuration)' == 'Debug'">True</GenerateTestArtifacts>
    <GenerateTestArtifacts Condition="'$(Configuration)' != 'Debug'">False</GenerateTestArtifacts>
    <AppInstallerUri>bin\Release\net11.0-windows10.0.19041.0\win-x64\AppPackages</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <UserSecretsId>543d9e88-b60c-4397-bc9d-c4614b8b1dcb</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <JloArch Include="armeabi-v7a;arm64-v8a;x86;x86_64" />
  </ItemGroup>

  <Target Name="CreateJloPlaceholders" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ItemGroup>
      <JloPaths Include="@(JloArch->'$(BaseIntermediateOutputPath)android\assets\%(Identity)\$(JloFileName)')" />
    </ItemGroup>
    <Message Text="Ensuring Android .jlo placeholders exist for packaging: @(JloPaths)" Importance="Low" />
    <!-- Make directories for each path -->
    <MakeDir Directories="@(JloPaths->'%(RootDir)%(Directory)')" />
    <!-- Create file if missing -->
    <WriteLinesToFile File="%(JloPaths.Identity)" Lines="&lt;?xml version='1.0' encoding='utf-8'?&gt;&lt;jlo /&gt;" Overwrite="false" Condition="!Exists('%(JloPaths.Identity)')" />
  </Target>

  <!-- Run unit tests during build (only on developer machines) -->
  <Target Name="RunUnitTests" AfterTargets="Build" Condition=" '$(RunUnitTestsOnBuild)' == 'true' ">
    <Exec WorkingDirectory="$(SolutionDir)tests" Command="dotnet test --no-build --verbosity minimal" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <MauiAsset Include="appsettings.json" CopyToOutputDirectory="Always" />
    <!-- Include as EmbeddedResource on all platforms for consistent embedded loading -->
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
        HomeUi cross-targets (net11.0 drawn by Avalonia in VardyParty.Desktop,
        net11.0-android/-windows compiled natively into this head).
        Directory.Build.targets strips TargetFramework off every
        ProjectReference, which breaks the cross-targeting reference protocol
        (no compiled output comes back) - so this one reference keeps
        TargetFramework negotiation and only strips the RID/SelfContained
        globals.
    -->
    <ProjectReference Include="..\VardyParty.HomeUi\VardyParty.HomeUi.csproj">
      <GlobalPropertiesToRemove>RuntimeIdentifier;RuntimeIdentifiers;SelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
    <!-- Strip MAUI TargetFrameworks/RID so net11.0 domain libraries restore as net11.0, not NETSDK1005. -->
    <ProjectReference Include="..\VardyParty.Hosting\VardyParty.Hosting.csproj">
      <GlobalPropertiesToRemove>RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetFramework;TargetFrameworks</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\VardyParty.Playback\VardyParty.Playback.csproj">
      <GlobalPropertiesToRemove>RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetFramework;TargetFrameworks</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\VardyParty.Presentation\VardyParty.Presentation.csproj">
      <GlobalPropertiesToRemove>RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetFramework;TargetFrameworks</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

    <!-- Local dev: sign with certificate from local cert store (not available on CI runners) -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release' and '$(CI)' != 'true'">
        <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
        <PackageCertificateThumbprint>288C22050831E54B0553CC6932F67FC809879A22</PackageCertificateThumbprint>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <!-- MSIX packaging defaults for Windows -->
    <!-- CI: signing disabled (no cert). CD: PFX decoded from secrets. Local: thumbprint from cert store (above). -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
      <WindowsPackageType>MSIX</WindowsPackageType>
      <CertificateFilePath>$(MSBuildProjectDirectory)\certs\vardyparty.pfx</CertificateFilePath>
      <!-- PFX exists (CD): override to sign with PFX file -->
      <AppxPackageSigningEnabled Condition="Exists('$(CertificateFilePath)')">true</AppxPackageSigningEnabled>
      <PackageCertificateKeyFile Condition="Exists('$(CertificateFilePath)')">$(CertificateFilePath)</PackageCertificateKeyFile>
      <PackageCertificatePassword Condition="Exists('$(CertificateFilePath)')">$(MSIX_CERT_PASSWORD)</PackageCertificatePassword>
      <!-- CI without PFX: explicitly disable signing so build succeeds unsigned -->
      <AppxPackageSigningEnabled Condition="!Exists('$(CertificateFilePath)') and '$(CI)' == 'true'">false</AppxPackageSigningEnabled>
    </PropertyGroup>

    <!-- Android-specific overrides (none; using defaults for linker/shrinker) -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-android' and '$(Configuration)' == 'Release'">
	    <AndroidKeyStore>True</AndroidKeyStore>
	    <AndroidSigningKeyStore>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'certs', 'vardyparty.keystore'))</AndroidSigningKeyStore>
	    <AndroidSigningKeyAlias>vardyparty</AndroidSigningKeyAlias>
	    <AndroidSigningKeyPass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
	    <AndroidSigningStorePass>$(ANDROID_SIGNING_STORE_PASS)</AndroidSigningStorePass>
    </PropertyGroup>

    <!-- Loose-register deploys from OutputPath\AppX; incremental builds often refresh win-x64 only. -->
    <Target Name="SyncWindowsAppXLayout" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0' and Exists('$(OutputPath)AppX')">
      <PropertyGroup>
        <_WinOutputRoot>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_WinOutputRoot>
        <_AppXRoot>$(_WinOutputRoot)AppX\</_AppXRoot>
      </PropertyGroup>
      <ItemGroup>
        <_AppXBinary Include="$(_WinOutputRoot)*.dll;$(_WinOutputRoot)*.exe;$(_WinOutputRoot)*.json;$(_WinOutputRoot)*.pri" />
      </ItemGroup>
      <Copy SourceFiles="@(_AppXBinary)" DestinationFolder="$(_AppXRoot)" SkipUnchangedFiles="false" />
      <!-- Maui splash/tile PNGs: refresh AppX from resizetizer, then mirror beside AppxManifest for loose-register. -->
      <ItemGroup>
        <_ResizetizerPng Include="$(IntermediateOutputPath)resizetizer\sp\*.png;$(IntermediateOutputPath)resizetizer\r\*.png" />
        <_MsixAssetBase Include="vardyparty_splashStoreLogo;vardyparty_splashMediumTile;vardyparty_splashLogo;vardyparty_splashSmallTile;vardyparty_splashWideTile;vardyparty_splashLargeTile;vardyparty_splash_generatedSplashScreen" />
        <_MsixAssetScale100 Include="@(_MsixAssetBase->'$(_AppXRoot)%(Identity).scale-100.png')"
                             Condition="Exists('$(_AppXRoot)%(Identity).scale-100.png')">
          <_Dest>$(_AppXRoot)%(Identity).png</_Dest>
        </_MsixAssetScale100>
        <_AppXLooseAsset Include="$(_AppXRoot)*.png;$(_AppXRoot)resources.pri" />
      </ItemGroup>
      <Copy SourceFiles="@(_ResizetizerPng)"
            DestinationFolder="$(_AppXRoot)"
            SkipUnchangedFiles="false"
            Condition="'@(_ResizetizerPng)' != ''" />
      <Copy SourceFiles="@(_MsixAssetScale100)"
            DestinationFiles="%(_MsixAssetScale100._Dest)"
            SkipUnchangedFiles="false"
            Condition="'@(_MsixAssetScale100)' != ''" />
      <Copy SourceFiles="@(_AppXLooseAsset)"
            DestinationFolder="$(_WinOutputRoot)"
            SkipUnchangedFiles="false"
            Condition="'@(_AppXLooseAsset)' != ''" />
    </Target>

    <!-- Keep MSIX loose layout in sync with league logo MauiAssets (AppX folder is not always refreshed on incremental builds). -->
    <Target Name="SyncLeagueLogosToWindowsLayout" AfterTargets="SyncWindowsAppXLayout" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
      <ItemGroup>
        <_LeagueLogoFile Include="$(MSBuildProjectDirectory)\Resources\Images\Leagues\**\*.*" />
      </ItemGroup>
      <PropertyGroup>
        <_WinOutputRoot>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_WinOutputRoot>
      </PropertyGroup>
      <MakeDir Directories="$(_WinOutputRoot)images\leagues;$(_WinOutputRoot)AppX\images\leagues" />
      <Copy SourceFiles="@(_LeagueLogoFile)"
            DestinationFiles="@(_LeagueLogoFile->'$(_WinOutputRoot)images\leagues\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
      <Copy SourceFiles="@(_LeagueLogoFile)"
            DestinationFiles="@(_LeagueLogoFile->'$(_WinOutputRoot)AppX\images\leagues\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="Exists('$(_WinOutputRoot)AppX')" />
    </Target>

    <!-- Same staleness issue for the UI sound MauiAssets (LogicalName Sounds/*.wav):
         SyncWindowsAppXLayout's binary allowlist never refreshes the Sounds
         subfolder, so VS/dotnet-driven incremental syncs shipped stale or missing
         WAVs and WindowsUiSoundPlayer found nothing to preload. Mirrors the
         league-logos target above (run-windows-debug.ps1's recursive sync already
         covers script-driven deploys). -->
    <Target Name="SyncSoundsToWindowsLayout" AfterTargets="SyncWindowsAppXLayout" Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
      <ItemGroup>
        <_UiSoundFile Include="$(MSBuildProjectDirectory)\Resources\Raw\Sounds\**\*.*" />
      </ItemGroup>
      <PropertyGroup>
        <_WinOutputRoot>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_WinOutputRoot>
      </PropertyGroup>
      <MakeDir Directories="$(_WinOutputRoot)Sounds;$(_WinOutputRoot)AppX\Sounds" />
      <Copy SourceFiles="@(_UiSoundFile)"
            DestinationFiles="@(_UiSoundFile->'$(_WinOutputRoot)Sounds\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
      <Copy SourceFiles="@(_UiSoundFile)"
            DestinationFiles="@(_UiSoundFile->'$(_WinOutputRoot)AppX\Sounds\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="Exists('$(_WinOutputRoot)AppX')" />
    </Target>

    <!-- Auto-update Windows Package.appxmanifest version from ApplicationDisplayVersion -->
    <Target Name="UpdateWindowsManifestVersion" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <PropertyGroup>
            <ManifestPath>$(MSBuildProjectDirectory)\Platforms\Windows\Package.appxmanifest</ManifestPath>
            <WindowsVersion>$(ApplicationDisplayVersion).0</WindowsVersion>
        </PropertyGroup>
        <Message Text="Updating Package.appxmanifest version to $(WindowsVersion)" Importance="high" />
        <Exec Command="powershell -NoProfile -Command &quot;(Get-Content '$(ManifestPath)') -replace 'Version=&quot;[\d.]+&quot;', 'Version=&quot;$(WindowsVersion)&quot;' | Set-Content '$(ManifestPath)'&quot;" />
    </Target>

    <!-- Local Development: patch SOURCE appsettings.json with user-secrets so
         they are embedded (MauiAsset + EmbeddedResource) for Android APKs and
         Windows loose/MSIX debug. Usage: -p:PatchAppSettings=true
         WARNING: modifies the source file. Revert: git restore VardyParty\appsettings.json -->
    <Target Name="PatchAppSettingsForLocalAndroid" BeforeTargets="BeforeBuild" Condition="'$(PatchAppSettings)' == 'true' AND ('$(TargetFramework)' == 'net11.0-android' OR '$(TargetFramework)' == 'net11.0-windows10.0.19041.0')">
        <PropertyGroup>
            <SourceAppSettingsPath>$(MSBuildProjectDirectory)\appsettings.json</SourceAppSettingsPath>
            <UserSecretsId>$(UserSecretsId)</UserSecretsId>
        </PropertyGroup>
        <Message Text="[LOCAL BUILD] Patching SOURCE appsettings.json with user secrets BEFORE build" Importance="high" />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\patch-appsettings.ps1&quot; -AppSettingsPath &quot;$(SourceAppSettingsPath)&quot; -UserSecretsId &quot;$(UserSecretsId)&quot;" />
    </Target>

</Project>
