<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 
    Centralized version management for all VardyParty applications (MAUI and Linux/Avalonia).
    
    Version scheme:
    - ApplicationVersion: Internal build counter. Set on the feature branch
      (`.githooks/pre-commit` + `ApplicationVersion on PR` workflow) so it
      merges with the product PR. CD packages that number after main CI.
    - ApplicationDisplayVersion: User-facing Major.Minor.Patch (manual "Bump Display Version" workflow)
  -->
  <PropertyGroup>
    <!-- Internal build counter — bumped on the PR branch before merge to main -->
    <ApplicationVersion>173</ApplicationVersion>
    
    <!-- User-facing semantic version - bump via Actions → Bump Display Version (workflow_dispatch) -->
    <ApplicationDisplayVersion>2.1.5</ApplicationDisplayVersion>
    
    <!-- Product name for versioning -->
    <Product>VardyParty</Product>
    <Company>Vardy Party</Company>
  </PropertyGroup>
</Project>
