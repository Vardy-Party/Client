<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 
    Centralized version management for all VardyParty applications (MAUI and Linux/Avalonia).
    
    Version scheme:
    - ApplicationVersion: Internal build counter (one unique value allocated per successful
      product CI on main, then used by CD for that merge's GitHub Release)
    - ApplicationDisplayVersion: User-facing Major.Minor.Patch (manual "Bump Display Version" workflow)
  -->
  <PropertyGroup>
    <!-- Internal build counter - allocated per main CI by Increment Build Version, then packaged -->
    <ApplicationVersion>150</ApplicationVersion>
    
    <!-- User-facing semantic version - bump via Actions → Bump Display Version (workflow_dispatch) -->
    <ApplicationDisplayVersion>1.7.116</ApplicationDisplayVersion>
    
    <!-- Product name for versioning -->
    <Product>VardyParty</Product>
    <Company>Vardy Party</Company>
  </PropertyGroup>
</Project>
