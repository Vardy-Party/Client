<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:hv="clr-namespace:VardyParty.HomeUi.Views;assembly=VardyParty.HomeUi"
             x:Class="VardyParty.Desktop.Pages.DesktopHomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0B0F1A">

    <Grid>
        <!-- The shared MAUI XAML homepage (same view the Android/Windows heads host). -->
        <hv:HomeView x:Name="HomeSurface" />

        <!-- Auth overlay: sign-in hero / device-code QR (same glue as HomeHostPage). -->
        <Grid x:Name="AuthOverlay" BackgroundColor="#0B0F1A" IsVisible="False">
            <ScrollView>
                <VerticalStackLayout Spacing="16"
                                     Padding="32"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     MaximumWidthRequest="560">
                    <Label Text="Vardy Party"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="AuthWelcomeLabel"
                           Text="Welcome — please sign in to browse today's matches."
                           FontSize="16"
                           TextColor="#8A93A6"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="SignInButton"
                            Text="Sign in — Continue"
                            Clicked="OnSignInClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="10"
                            Padding="24,12"
                            HorizontalOptions="Center" />

                    <VerticalStackLayout x:Name="DeviceCodePanel" IsVisible="False" Spacing="12">
                        <Label x:Name="DeviceCodeLabel"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Image x:Name="DeviceQrImage"
                               WidthRequest="240"
                               HeightRequest="240"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label x:Name="DeviceUriLabel"
                               FontSize="15"
                               TextColor="#8A93A6"
                               HorizontalTextAlignment="Center" />
                        <Button x:Name="CancelSignInButton"
                                Text="Cancel"
                                Clicked="OnCancelSignInClicked"
                                BackgroundColor="#1C2333"
                                TextColor="#E5E7EB"
                                CornerRadius="10"
                                Padding="24,10"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Label x:Name="AuthStatusLabel"
                           IsVisible="False"
                           FontSize="15"
                           TextColor="#FECACA"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Stream-resolution progress overlay (same glue as HomeHostPage). -->
        <Grid x:Name="ResolveOverlay" BackgroundColor="#D9000000" IsVisible="False">
            <Border BackgroundColor="#111726"
                    Stroke="#26FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="28,22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="360">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ResolveTitleLabel"
                           Text="Finding streams..."
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ResolveStatusLabel"
                           IsVisible="False"
                           FontSize="15"
                           TextColor="#8A93A6"
                           HorizontalTextAlignment="Center" />
                    <ProgressBar x:Name="ResolveProgressBar"
                                 ProgressColor="#2563EB" />
                    <Label x:Name="ResolveCountLabel"
                           FontSize="13"
                           TextColor="#5B6478"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="ResolveCancelButton"
                            Text="Cancel"
                            Clicked="OnResolveCancelClicked"
                            BackgroundColor="#1C2333"
                            TextColor="#E5E7EB"
                            CornerRadius="10"
                            Padding="24,8"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--
            Playback panel. With the EmbeddedDesktopVideo build switch ON
            (default) the video renders IN-WINDOW: code-behind injects a
            VideoHostView into VideoHostContainer and the service attaches
            the MediaPlayer drawable to it (see DesktopVideoPlayerService).

            AIRSPACE: the embedded video is a NATIVE child window stacked
            above the Avalonia-drawn scene, so any MAUI content overlapping
            the video row would be covered by it. Every interactive/overlay
            element — the title, the Close control and the in-playback
            match-event toast — therefore lives in the reserved top chrome
            strip and never overlaps the video row.

            Standalone fallback (switch OFF, or the hosted surface failed at
            runtime): libvlc opens its own native video window, the video row
            shows the "own window" card instead, and the same chrome strip
            carries Close and the toast (toasts then show in the app window
            next to the external video window — documented behaviour).
        -->
        <Grid x:Name="PlaybackOverlay" BackgroundColor="#0B0F1A" IsVisible="False" RowDefinitions="108,*">
            <!-- Chrome strip: title | in-playback toast | Close. -->
            <Grid Padding="20,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="2" VerticalOptions="Start">
                    <Label Text="Now Playing"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="PlaybackTitleLabel"
                           FontSize="14"
                           TextColor="#8A93A6" />
                </VerticalStackLayout>

                <!-- In-playback match-event toast (MatchEventBus consumer).
                     The negative top margin compensates the toast card's own
                     page-padding margin so it fits the 108px strip. -->
                <Grid Grid.Column="1" Margin="0,-22,0,0">
                    <hv:MatchEventToastView x:Name="PlaybackToast" InputTransparent="True" />
                </Grid>

                <!-- Close must stay clickable at every moment, including a
                     wedged libvlc: the handler never runs a libvlc call on
                     the UI thread (see DesktopVideoPlayerService). -->
                <Button Grid.Column="2"
                        x:Name="ClosePlaybackButton"
                        Text="✕  Close playback"
                        Clicked="OnClosePlaybackClicked"
                        VerticalOptions="Start"
                        BackgroundColor="#1C2333"
                        TextColor="#E5E7EB"
                        CornerRadius="10"
                        Padding="20,10" />
            </Grid>

            <!-- In-window video surface (VideoHostView injected in code-behind
                 under EMBEDDED_DESKTOP_VIDEO; hidden in standalone fallback). -->
            <Grid Grid.Row="1" x:Name="VideoHostContainer" BackgroundColor="Black" IsVisible="False" />

            <!-- Standalone-window fallback card (pre-feature behaviour). -->
            <Grid Grid.Row="1" x:Name="StandalonePlaybackPanel">
                <Border BackgroundColor="#111726"
                        Stroke="#26FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="28,22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="360">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Video is playing in its own window."
                               FontSize="14"
                               TextColor="#8A93A6"
                               HorizontalTextAlignment="Center" />
                        <Label Text="In-window playback is unavailable on this setup — the standalone libvlc window is being used instead."
                               FontSize="12"
                               TextColor="#5B6478"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="420" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
