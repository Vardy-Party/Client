<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:hv="clr-namespace:VardyParty.HomeUi.Views;assembly=VardyParty.HomeUi"
             x:Class="VardyParty.Desktop.Pages.DesktopHomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0B0F1A">

    <Grid>
        <!-- The shared MAUI XAML homepage (same view the Android/Windows heads host). -->
        <hv:HomeView x:Name="HomeSurface" />

        <!-- Auth overlay: sign-in hero / device-code QR (same glue as HomeHostPage). -->
        <Grid x:Name="AuthOverlay" BackgroundColor="#0B0F1A" IsVisible="False">
            <ScrollView>
                <VerticalStackLayout Spacing="16"
                                     Padding="32"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     MaximumWidthRequest="560">
                    <Label Text="Vardy Party"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="AuthWelcomeLabel"
                           Text="Welcome — please sign in to browse today's matches."
                           FontSize="16"
                           TextColor="#8A93A6"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="SignInButton"
                            Text="Sign in — Continue"
                            Clicked="OnSignInClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="10"
                            Padding="24,12"
                            HorizontalOptions="Center" />

                    <VerticalStackLayout x:Name="DeviceCodePanel" IsVisible="False" Spacing="12">
                        <Label x:Name="DeviceCodeLabel"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Image x:Name="DeviceQrImage"
                               WidthRequest="240"
                               HeightRequest="240"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label x:Name="DeviceUriLabel"
                               FontSize="15"
                               TextColor="#8A93A6"
                               HorizontalTextAlignment="Center" />
                        <Button x:Name="CancelSignInButton"
                                Text="Cancel"
                                Clicked="OnCancelSignInClicked"
                                BackgroundColor="#1C2333"
                                TextColor="#E5E7EB"
                                CornerRadius="10"
                                Padding="24,10"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Label x:Name="AuthStatusLabel"
                           IsVisible="False"
                           FontSize="15"
                           TextColor="#FECACA"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Stream-resolution progress overlay (same glue as HomeHostPage). -->
        <Grid x:Name="ResolveOverlay" BackgroundColor="#D9000000" IsVisible="False">
            <Border BackgroundColor="#111726"
                    Stroke="#26FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="28,22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="360">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="ResolveTitleLabel"
                           Text="Finding streams..."
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ResolveStatusLabel"
                           IsVisible="False"
                           FontSize="15"
                           TextColor="#8A93A6"
                           HorizontalTextAlignment="Center" />
                    <ProgressBar x:Name="ResolveProgressBar"
                                 ProgressColor="#2563EB" />
                    <Label x:Name="ResolveCountLabel"
                           FontSize="13"
                           TextColor="#5B6478"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="ResolveCancelButton"
                            Text="Cancel"
                            Clicked="OnResolveCancelClicked"
                            BackgroundColor="#1C2333"
                            TextColor="#E5E7EB"
                            CornerRadius="10"
                            Padding="24,8"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--
            Playback panel. With the EmbeddedDesktopVideo build switch ON
            (default) the video renders IN-WINDOW: code-behind injects a
            VideoHostView into VideoHostContainer and the service attaches
            the MediaPlayer drawable to it (see DesktopVideoPlayerService).

            AIRSPACE CONSTRAINT: the embedded video is a NATIVE child window
            stacked above the Avalonia-drawn scene. Any MAUI control that
            overlaps the video row is covered by that child — invisible and
            unclickable. Do NOT move Close (or any other interactive control)
            on top of the video to "save a few pixels": it will look right
            in the designer and fail in the field (the original WSL Close
            wedge). The reserved strip is therefore a separate grid row
            ABOVE the video, sized to a single Close chip — not a titled
            "Now Playing" header. Match-event toasts live in the same
            reserved row (they are input-transparent; they must stay off
            the video row or the native surface would hide them). The Auto
            row stays ~40px when idle and grows only while a toast is up.

            Standalone fallback (switch OFF, or the hosted surface failed at
            runtime): libvlc opens its own native video window, the video row
            shows the "own window" card instead, and the same Close chip /
            toast row stays in the app window.
        -->
        <Grid x:Name="PlaybackOverlay" BackgroundColor="#0B0F1A" IsVisible="False" RowDefinitions="Auto,*">
            <Grid MinimumHeightRequest="40" Padding="8,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <hv:MatchEventToastView x:Name="PlaybackToast"
                                        InputTransparent="True"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                <!-- Close must stay clickable at every moment, including a
                     wedged libvlc: the handler never runs a libvlc call on
                     the UI thread (see DesktopVideoPlayerService). Escape
                     is the same cancel path (Avalonia TopLevel KeyDown). -->
                <Button Grid.Column="1"
                        x:Name="ClosePlaybackButton"
                        Text="✕"
                        Clicked="OnClosePlaybackClicked"
                        VerticalOptions="Start"
                        HorizontalOptions="End"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        BackgroundColor="#CC1C2333"
                        TextColor="#E5E7EB"
                        CornerRadius="18"
                        FontSize="16"
                        SemanticProperties.Description="Close playback" />
            </Grid>

            <!-- In-window video surface (VideoHostView injected in code-behind
                 under EMBEDDED_DESKTOP_VIDEO; hidden in standalone fallback). -->
            <Grid Grid.Row="1" x:Name="VideoHostContainer" BackgroundColor="Black" IsVisible="False" />

            <!-- Standalone-window fallback card (pre-feature behaviour). -->
            <Grid Grid.Row="1" x:Name="StandalonePlaybackPanel">
                <Border BackgroundColor="#111726"
                        Stroke="#26FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="28,22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="360">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Video is playing in its own window."
                               FontSize="14"
                               TextColor="#8A93A6"
                               HorizontalTextAlignment="Center" />
                        <Label Text="In-window playback is unavailable on this setup — the standalone libvlc window is being used instead."
                               FontSize="12"
                               TextColor="#5B6478"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="420" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
