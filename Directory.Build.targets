<Project>
  <!--
    MAUI `dotnet build -f net11.0-android -p:TargetFrameworks=net11.0-android -r android-arm64`
    flows those global properties into every ProjectReference. Domain libraries target
    net11.0 only. If their assets are restored as net11.0-android (or RID-only), the
    next build is NETSDK1005 ("doesn't have a target for 'net11.0'").
    Exes (Desktop, StreamHealthCheckerTool) keep their own RuntimeIdentifier(s).
  -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>$(GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetFramework;TargetFrameworks</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' AND '$(UseMaui)' != 'true' AND '$(OutputType)' != 'Exe' AND '$(OutputType)' != 'WinExe'">
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
